    "\n",
    "# Equivalencias aproximadas (para contexto)\n",
    "# 1 auto promedio emite ~4.6 tCO₂/año\n",
    "equivalencia_autos = abs(balance_total_anual) / 4.6\n",
    "# 1 árbol maduro absorbe ~22 kg CO₂/año = 0.022 tCO₂/año  \n",
    "equivalencia_arboles = abs(balance_total_anual) / 0.022\n",
    "\n",
    "categorias = ['Balance Anual\\n(tCO₂/ha)', 'Equiv. Autos\\n(unidades)', 'Equiv. Árboles\\n(unidades)']\n",

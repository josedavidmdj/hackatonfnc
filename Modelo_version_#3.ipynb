    "# ========================================\n",
    "# VISUALIZACIÓN FINAL CORREGIDA (tCO₂/ha/año)\n",
    "# ========================================\n",
    "\n",
    "print(\"📊 GENERANDO VISUALIZACIÓN FINAL CORREGIDA...\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "# Crear figura final con valores correctos\n",
    "fig, axes = plt.subplots(2, 2, figsize=(16, 12))\n",
    "fig.suptitle('🌱 ANÁLISIS NEE CORRECTO - CALDAS 2018 (tCO₂/ha/año)', fontsize=16, fontweight='bold')\n",
    "\n",
    "# Datos correctos para visualización\n",
    "promedios_mensuales_correctos = [resumen_mensual_correcto.loc[i, 'mean'] for i in range(1, 13)]\n",
    "std_mensuales_correctos = [resumen_mensual_correcto.loc[i, 'std'] for i in range(1, 13)]\n",
    "balance_mensual_correcto = [resumen_mensual_correcto.loc[i, 'sum'] for i in range(1, 13)]\n",
    "\n",
    "# 1. PROMEDIO MENSUAL CORRECTO\n",
    "ax1 = axes[0, 0]\n",
    "ax1.errorbar(range(1, 13), promedios_mensuales_correctos, yerr=std_mensuales_correctos, \n",
    "            marker='o', linewidth=2, markersize=8, capsize=5, capthick=2, color='darkgreen')\n",
    "ax1.set_xlabel('Mes', fontweight='bold')\n",
    "ax1.set_ylabel('NEE (tCO₂/ha/año)', fontweight='bold')\n",
    "ax1.set_title('Promedio Mensual del NEE', fontweight='bold')\n",
    "ax1.set_xticks(range(1, 13))\n",
    "ax1.set_xticklabels(meses_nombres_cortos, rotation=45)\n",
    "ax1.grid(True, alpha=0.3)\n",
    "ax1.axhline(y=0, color='red', linestyle='--', alpha=0.7, label='Balance neutro')\n",
    "ax1.legend()\n",
    "\n",
    "# Colorear según absorción/emisión\n",
    "for i, valor in enumerate(promedios_mensuales_correctos):\n",
    "    color = 'green' if valor < 0 else 'orange'\n",
    "    ax1.scatter(i+1, valor, s=100, c=color, alpha=0.7, zorder=5)\n",
    "\n",
    "# 2. BALANCE MENSUAL ACUMULADO CORRECTO\n",
    "ax2 = axes[0, 1]\n",
    "balance_acumulado_correcto = [sum(balance_mensual_correcto[:i+1]) for i in range(12)]\n",
    "\n",
    "bars = ax2.bar(range(1, 13), balance_mensual_correcto, alpha=0.7, \n",
    "               color=['green' if x < 0 else 'orange' for x in balance_mensual_correcto])\n",
    "ax2_twin = ax2.twinx()\n",
    "ax2_twin.plot(range(1, 13), balance_acumulado_correcto, 'r-o', linewidth=3, markersize=8, \n",
    "              label='Acumulado', alpha=0.8)\n",
    "\n",
    "ax2.set_xlabel('Mes', fontweight='bold')\n",
    "ax2.set_ylabel('Balance Mensual (tCO₂/ha)', fontweight='bold', color='blue')\n",
    "ax2_twin.set_ylabel('Balance Acumulado (tCO₂/ha)', fontweight='bold', color='red')\n",
    "ax2.set_title('Balance de Carbono Mensual', fontweight='bold')\n",
    "ax2.set_xticks(range(1, 13))\n",
    "ax2.set_xticklabels(meses_nombres_cortos, rotation=45)\n",
    "ax2.grid(True, alpha=0.3)\n",
    "ax2.axhline(y=0, color='gray', linestyle='-', alpha=0.5)\n",
    "ax2_twin.legend()\n",

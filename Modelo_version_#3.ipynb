    "            encontrada = True\n",
    "            print(f\"   ✅ {var_modelo} → {col_era5} (coincidencia exacta)\")\n",
    "            break\n",
    "        elif any(parte in col_era5.lower() for parte in var_modelo.lower().split('_')):\n",

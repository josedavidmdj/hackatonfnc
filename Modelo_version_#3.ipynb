    "# ========================================\n",
    "# DIAGNÓSTICO Y CORRECCIÓN DEL ORDEN DE VARIABLES\n",
    "# ========================================\n",
    "\n",
    "print(\"🔍 DIAGNOSTICANDO PROBLEMA CON EL SCALER\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "# Verificar las características que el scaler espera\n",
    "if hasattr(scaler, 'feature_names_in_'):\n",
    "    caracteristicas_esperadas = list(scaler.feature_names_in_)\n",
    "    print(f\"🔧 CARACTERÍSTICAS ESPERADAS POR EL SCALER:\")\n",
    "    for i, feat in enumerate(caracteristicas_esperadas, 1):\n",
    "        print(f\"   {i}. {feat}\")\n",
    "else:\n",
    "    print(\"⚠️ El scaler no tiene información de nombres de características\")\n",
    "    caracteristicas_esperadas = None\n",
    "\n",
    "# Verificar las características que tenemos en los datos\n",
    "caracteristicas_disponibles = list(X_nuevos.columns)\n",
    "print(f\"\\n📊 CARACTERÍSTICAS DISPONIBLES EN LOS DATOS:\")\n",
    "for i, feat in enumerate(caracteristicas_disponibles, 1):\n",
    "    print(f\"   {i}. {feat}\")\n",
    "\n",
    "if caracteristicas_esperadas:\n",
    "    # Comparar las características\n",
    "    caracteristicas_faltantes = set(caracteristicas_esperadas) - set(caracteristicas_disponibles)\n",
    "    caracteristicas_extra = set(caracteristicas_disponibles) - set(caracteristicas_esperadas)\n",
    "    \n",
    "    print(f\"\\n🔍 COMPARACIÓN:\")\n",
    "    if caracteristicas_faltantes:\n",
    "        print(f\"   ❌ Faltantes en datos: {list(caracteristicas_faltantes)}\")\n",
    "    if caracteristicas_extra:\n",
    "        print(f\"   ⚠️ Extra en datos: {list(caracteristicas_extra)}\")\n",
    "    \n",
    "    if not caracteristicas_faltantes and not caracteristicas_extra:\n",
    "        print(f\"   ✅ Las características coinciden\")\n",
    "        # Reordenar los datos para que coincidan con el orden del scaler\n",
    "        X_nuevos_ordenado = X_nuevos[caracteristicas_esperadas]\n",
    "    else:\n",
    "        print(f\"   🔧 Ajustando características...\")\n",
    "        # Usar solo las características que coinciden\n",
    "        caracteristicas_comunes = list(set(caracteristicas_esperadas) & set(caracteristicas_disponibles))\n",
    "        print(f\"   📋 Características comunes: {caracteristicas_comunes}\")\n",
    "        \n",
    "        if len(caracteristicas_comunes) > 0:\n",
    "            X_nuevos_ordenado = X_nuevos[caracteristicas_comunes]\n",
    "            print(f\"   ✅ Usando {len(caracteristicas_comunes)} características comunes\")\n",
    "        else:\n",
    "            print(f\"   ❌ No hay características comunes\")\n",
    "            X_nuevos_ordenado = None\n",
    "else:\n",
    "    # Si no tenemos información del scaler, usar los datos como están\n",
    "    print(f\"\\n⚠️ Procediendo sin verificación de orden\")\n",
    "    X_nuevos_ordenado = X_nuevos\n",
    "\n",
    "# Intentar aplicar el modelo con las características corregidas\n",
    "if X_nuevos_ordenado is not None:\n",
    "    print(f\"\\n🔮 APLICANDO MODELO CON CARACTERÍSTICAS CORREGIDAS...\")\n",
    "    \n",
    "    try:\n",
    "        # Intentar escalar si tenemos el scaler y las características coinciden\n",
    "        if 'scaler' in globals() and caracteristicas_esperadas and len(set(caracteristicas_esperadas) & set(X_nuevos_ordenado.columns)) == len(caracteristicas_esperadas):\n",
    "            print(f\"🔄 Aplicando escalado...\")\n",
    "            X_procesado = scaler.transform(X_nuevos_ordenado)\n",
    "            print(f\"   ✅ Escalado aplicado correctamente\")\n",
    "        else:\n",
    "            print(f\"⚠️ Usando datos sin escalar\")\n",
    "            X_procesado = X_nuevos_ordenado.values\n",
    "        \n",
    "        # Aplicar el modelo\n",
    "        if 'modelo' in globals():\n",
    "            predicciones_nee = modelo.predict(X_procesado)\n",
    "            \n",
    "            print(f\"\\n✅ PREDICCIONES GENERADAS EXITOSAMENTE\")\n",
    "            print(f\"   • Modelo usado: {type(modelo).__name__}\")\n",
    "            print(f\"   • Registros procesados: {len(predicciones_nee):,}\")\n",
    "            print(f\"   • Características usadas: {X_nuevos_ordenado.shape[1]}\")\n",
    "            \n",
    "            # Añadir predicciones al DataFrame original\n",
    "            df_para_prediccion = df_completo[df_completo['NDVI'].notna()].copy()\n",
    "            df_para_prediccion['NEE_predicho'] = predicciones_nee\n",
    "            \n",
    "            # Estadísticas básicas\n",
    "            print(f\"\\n📊 ESTADÍSTICAS DE PREDICCIONES NEE:\")\n",
    "            print(f\"   • Promedio: {predicciones_nee.mean():.4f}\")\n",
    "            print(f\"   • Mínimo: {predicciones_nee.min():.4f}\")\n",
    "            print(f\"   • Máximo: {predicciones_nee.max():.4f}\")\n",
    "            print(f\"   • Desviación estándar: {predicciones_nee.std():.4f}\")\n",
    "            \n",
    "            # Análisis espacial básico\n",
    "            nee_por_ubicacion = df_para_prediccion.groupby(['latitude', 'longitude'])['NEE_predicho'].agg(['mean', 'std', 'count'])\n",
    "            print(f\"\\n📍 ANÁLISIS ESPACIAL:\")\n",
    "            print(f\"   • Ubicaciones únicas: {len(nee_por_ubicacion)}\")\n",
    "            print(f\"   • NEE promedio global: {df_para_prediccion['NEE_predicho'].mean():.4f}\")\n",
    "            \n",
    "            # Guardar resultados\n",
    "            archivo_resultados = 'predicciones_nee_completas.csv'\n",
    "            columnas_salida = ['valid_time', 'latitude', 'longitude', 'NDVI', 'PRI', 'TA_1_1_1', 'NEE_predicho']\n",
    "            df_para_prediccion[columnas_salida].to_csv(archivo_resultados, index=False)\n",
    "            \n",
    "            print(f\"\\n💾 RESULTADOS GUARDADOS:\")\n",
    "            print(f\"   • Archivo: {archivo_resultados}\")\n",
    "            print(f\"   • Registros: {len(df_para_prediccion):,}\")\n",
    "            print(f\"   • Columnas: {columnas_salida}\")\n",
    "            \n",
    "            print(f\"\\n✅ APLICACIÓN DEL MODELO COMPLETADA EXITOSAMENTE\")\n",
    "            \n",
    "        else:\n",
    "            print(f\"❌ Modelo no disponible\")\n",
    "            \n",
    "    except Exception as e:\n",
    "        print(f\"❌ Error al aplicar el modelo: {e}\")\n",
    "        print(f\"🔧 Información de debug:\")\n",
    "        print(f\"   • Forma de datos de entrada: {X_nuevos_ordenado.shape}\")\n",
    "        if hasattr(modelo, 'n_features_in_'):\n",
    "            print(f\"   • Características esperadas por modelo: {modelo.n_features_in_}\")\n",
    "        raise\n",
    "\n",
    "else:\n",
    "    print(f\"❌ No se pudieron preparar los datos para el modelo\")"
   ]
  },

    "    df_predicciones['día_año'] = df_predicciones['fecha'].dt.dayofyear\n",
    "    \n",
    "    print(f\"\\n📅 PERÍODO DE ANÁLISIS:\")\n",
    "    print(f\"• Fecha inicio: {df_predicciones['fecha'].min()}\")\n",
    "    print(f\"• Fecha fin: {df_predicciones['fecha'].max()}\")\n",
    "    print(f\"• Años únicos: {sorted(df_predicciones['año'].unique())}\")\n",
    "    print(f\"• Meses únicos: {sorted(df_predicciones['mes'].unique())}\")\n",
    "    \n",
    "    # Estadísticas básicas del NEE\n",
    "    nee_valores = df_predicciones[columna_nee]\n",
    "    print(f\"\\n🌱 ESTADÍSTICAS GENERALES DEL NEE:\")\n",
    "    print(f\"• Promedio general: {nee_valores.mean():.4f} µmol CO₂/m²/s\")\n",
    "    print(f\"• Desviación estándar: {nee_valores.std():.4f}\")\n",
    "    print(f\"• Mínimo: {nee_valores.min():.4f}\")\n",
    "    print(f\"• Máximo: {nee_valores.max():.4f}\")\n",
    "    print(f\"• Mediana: {nee_valores.median():.4f}\")\n",
    "    \n",
    "    # Balance neto de carbono\n",
    "    absorcion = (nee_valores < 0).sum()\n",
    "    emision = (nee_valores >= 0).sum()\n",
    "    pct_absorcion = (absorcion / len(nee_valores)) * 100\n",
    "    \n",
    "    print(f\"\\n🌍 BALANCE NETO DE CARBONO:\")\n",
    "    print(f\"• Registros con absorción (NEE < 0): {absorcion:,} ({pct_absorcion:.1f}%)\")\n",
    "    print(f\"• Registros con emisión (NEE ≥ 0): {emision:,} ({100-pct_absorcion:.1f}%)\")\n",
    "    print(f\"• Balance neto total: {nee_valores.sum():.2f} µmol CO₂/m²/s\")\n",
    "    \n",
    "else:\n",
    "    print(\"❌ No se pueden calcular promedios sin datos de predicciones NEE\")"

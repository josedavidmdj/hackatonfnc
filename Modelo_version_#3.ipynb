    "# ========================================\n",
    "# ANÁLISIS CORREGIDO - LAS SALIDAS YA ESTÁN EN tCO₂/ha/año\n",
    "# ========================================\n",
    "\n",
    "print(\"✅ CORRECCIÓN: Usando valores originales del modelo (ya en tCO₂/ha/año)\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "# Usar directamente la columna original del modelo (NEE_predicho)\n",
    "# que ya está en las unidades correctas: tCO₂/ha/año\n",
    "nee_valores_correctos = df_predicciones[columna_nee]  # NEE_predicho\n",
    "\n",
    "print(\"🎯 ESTADÍSTICAS CORRECTAS EN tCO₂/ha/año:\")\n",
    "print(f\"• Promedio anual: {nee_valores_correctos.mean():.6f} tCO₂/ha/año\")\n",
    "print(f\"• Balance neto total: {nee_valores_correctos.sum():.4f} tCO₂/ha/año\")\n",
    "print(f\"• Rango: {nee_valores_correctos.min():.6f} a {nee_valores_correctos.max():.6f}\")\n",
    "print(f\"• Desviación estándar: {nee_valores_correctos.std():.6f}\")\n",
    "print(f\"• Mediana: {nee_valores_correctos.median():.6f}\")\n",
    "\n",
    "# Interpretar el balance\n",
    "balance_total_correcto = nee_valores_correctos.sum()\n",
    "if balance_total_correcto < 0:\n",
    "    print(f\"\\n🌱 INTERPRETACIÓN CORRECTA:\")\n",
    "    print(f\"• ✅ ECOSISTEMA SUMIDERO: Absorbe {abs(balance_total_correcto):.4f} tCO₂/ha/año\")\n",
    "    print(f\"• El ecosistema captura carbono neto del ambiente\")\n",
    "else:\n",
    "    print(f\"\\n🌱 INTERPRETACIÓN CORRECTA:\")\n",
    "    print(f\"• ⚠️ ECOSISTEMA FUENTE: Emite {balance_total_correcto:.4f} tCO₂/ha/año\")\n",
    "    print(f\"• El ecosistema libera carbono neto al ambiente\")\n",
    "\n",
    "# ========================================\n",
    "# RECALCULAR PROMEDIOS MENSUALES CORRECTOS\n",
    "# ========================================\n",
    "\n",
    "print(f\"\\n📅 PROMEDIOS MENSUALES CORRECTOS (tCO₂/ha/año):\")\n",
    "print(\"=\"*50)\n",
    "\n",
    "# Promedio mensual correcto\n",
    "promedio_mensual_correcto = df_predicciones.groupby(['año', 'mes'])[columna_nee].agg([\n",
    "    'mean', 'std', 'min', 'max', 'sum', 'count'\n",
    "]).round(6)\n",
    "\n",
    "for (año, mes), datos in promedio_mensual_correcto.iterrows():\n",
    "    mes_nombre = meses_esp[mes]\n",
    "    print(f\"📅 {mes_nombre} {año}:\")\n",
    "    print(f\"  • Promedio: {datos['mean']:.6f} tCO₂/ha/año\")\n",
    "    print(f\"  • Balance mensual: {datos['sum']:.4f} tCO₂/ha/año\")\n",
    "    print(f\"  • Rango: {datos['min']:.6f} a {datos['max']:.6f}\")\n",
    "\n",
    "# Resumen estadístico mensual correcto\n",
    "resumen_mensual_correcto = df_predicciones.groupby('mes')[columna_nee].agg([\n",
    "    'mean', 'std', 'min', 'max', 'sum', 'count'\n",
    "]).round(6)\n",
    "\n",
    "resumen_mensual_correcto['mes_nombre'] = [meses_esp[mes] for mes in resumen_mensual_correcto.index]\n",
    "resumen_mensual_correcto = resumen_mensual_correcto[['mes_nombre', 'mean', 'std', 'min', 'max', 'sum', 'count']]\n",
    "\n",
    "print(f\"\\n📊 RESUMEN MENSUAL CORRECTO:\")\n",
    "print(resumen_mensual_correcto.to_string(float_format='%.6f'))\n",
    "\n",
    "# ========================================\n",
    "# IDENTIFICAR EXTREMOS CORRECTOS\n",
    "# ========================================\n",
    "\n",
    "print(f\"\\n🔍 ANÁLISIS DE EXTREMOS CORRECTOS:\")\n",
    "\n",
    "# Mes con mayor absorción (más negativo)\n",
    "mes_mayor_absorcion_corr = resumen_mensual_correcto['mean'].idxmin()\n",
    "valor_mayor_absorcion_corr = resumen_mensual_correcto.loc[mes_mayor_absorcion_corr, 'mean']\n",
    "print(f\"• Mes con mayor absorción: {meses_esp[mes_mayor_absorcion_corr]} ({valor_mayor_absorcion_corr:.6f} tCO₂/ha/año)\")\n",
    "\n",
    "# Mes con menor absorción (menos negativo o más positivo)\n",
    "mes_menor_absorcion_corr = resumen_mensual_correcto['mean'].idxmax()\n",
    "valor_menor_absorcion_corr = resumen_mensual_correcto.loc[mes_menor_absorcion_corr, 'mean']\n",
    "print(f\"• Mes con menor absorción: {meses_esp[mes_menor_absorcion_corr]} ({valor_menor_absorcion_corr:.6f} tCO₂/ha/año)\")\n",
    "\n",
    "# Mes más variable\n",
    "mes_mas_variable_corr = resumen_mensual_correcto['std'].idxmax()\n",
    "variabilidad_max_corr = resumen_mensual_correcto.loc[mes_mas_variable_corr, 'std']\n",
    "print(f\"• Mes más variable: {meses_esp[mes_mas_variable_corr]} (std: {variabilidad_max_corr:.6f})\")\n",
    "\n",
    "# ========================================\n",
    "# CONTEXTO ECOLÓGICO CORRECTO\n",
    "# ========================================\n",
    "\n",
    "print(f\"\\n🌍 CONTEXTO ECOLÓGICO CORRECTO:\")\n",
    "\n",
    "# Equivalencias realistas\n",
    "# 1 árbol maduro absorbe ~22 kg CO₂/año = 0.022 tCO₂/año\n",
    "# 1 auto promedio emite ~4.6 tCO₂/año\n",
    "absorcion_anual = abs(balance_total_correcto) if balance_total_correcto < 0 else 0\n",
    "equivalencia_arboles_corr = absorcion_anual / 0.022 if absorcion_anual > 0 else 0\n",
    "equivalencia_autos_corr = absorcion_anual / 4.6 if absorcion_anual > 0 else 0\n",
    "\n",
    "if balance_total_correcto < 0:\n",
    "    print(f\"🌳 Equivalencias de absorción:\")\n",
    "    print(f\"  • Equivale a ~{equivalencia_arboles_corr:.0f} árboles maduros por hectárea/año\")\n",
    "    print(f\"  • Compensa ~{equivalencia_autos_corr:.1f} autos promedio por hectárea/año\")\n",
    "else:\n",
    "    print(f\"🚗 El ecosistema emite en lugar de absorber\")\n",
    "\n",
    "# Comparación con otros ecosistemas\n",
    "print(f\"\\n📊 COMPARACIÓN CON OTROS ECOSISTEMAS:\")\n",
    "print(f\"• Bosque tropical maduro: -5 a -15 tCO₂/ha/año\")\n",
    "print(f\"• Bosque secundario: -2 a -8 tCO₂/ha/año\")\n",
    "print(f\"• Pradera: -1 a -3 tCO₂/ha/año\")\n",
    "print(f\"• Caldas (2018): {balance_total_correcto:.4f} tCO₂/ha/año\")\n",
    "\n",
    "if balance_total_correcto < -2:\n",
    "    print(f\"✅ Ecosistema con buena capacidad de absorción\")\n",
    "elif balance_total_correcto < 0:\n",
    "    print(f\"✅ Ecosistema sumidero moderado\")\n",
    "else:\n",
    "    print(f\"⚠️ Ecosistema fuente de carbono\")\n",
    "\n",
    "# ========================================\n",
    "# GUARDAR RESULTADOS CORREGIDOS\n",
    "# ========================================\n",
    "\n",
    "print(f\"\\n💾 GUARDANDO RESULTADOS CORREGIDOS...\")\n",
    "\n",
    "# Guardar resumen mensual correcto\n",
    "resumen_mensual_correcto.to_csv('nee_promedio_mensual_2018_tCO2_ha_año_CORRECTO.csv', \n",
    "                               index=True, float_format='%.6f')\n",
    "print(\"✅ Guardado: nee_promedio_mensual_2018_tCO2_ha_año_CORRECTO.csv\")\n",
    "\n",
    "# Guardar promedio anual correcto\n",
    "promedio_anual_correcto = df_predicciones.groupby('año')[columna_nee].agg([\n",
    "    'mean', 'std', 'min', 'max', 'sum', 'count'\n",
    "]).round(6)\n",
    "\n",
    "promedio_anual_correcto.to_csv('nee_promedio_anual_2018_tCO2_ha_año_CORRECTO.csv', \n",
    "                              index=True, float_format='%.6f')\n",
    "print(\"✅ Guardado: nee_promedio_anual_2018_tCO2_ha_año_CORRECTO.csv\")\n",
    "\n",
    "# Guardar dataset con valores correctos\n",
    "df_predicciones[['valid_time', 'latitude', 'longitude', columna_nee]].to_csv(\n",
    "    'predicciones_nee_tCO2_ha_año_CORRECTO.csv', index=False, float_format='%.6f')\n",
    "print(\"✅ Guardado: predicciones_nee_tCO2_ha_año_CORRECTO.csv\")\n",
    "\n",
    "print(f\"\\n✅ ANÁLISIS CORREGIDO COMPLETADO\")\n",
    "print(f\"📋 RESUMEN FINAL CORRECTO:\")\n",
    "print(f\"  • Las predicciones del modelo YA estaban en tCO₂/ha/año\")\n",
    "print(f\"  • Balance anual: {balance_total_correcto:.4f} tCO₂/ha/año\")\n",
    "print(f\"  • Promedio: {nee_valores_correctos.mean():.6f} tCO₂/ha/año\")\n",
    "if balance_total_correcto < 0:\n",
    "    print(f\"  • ✅ Ecosistema sumidero de carbono\")"

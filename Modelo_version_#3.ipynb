   "source": [
    "# ========================================\n",
    "# CORRECCIÓN DE VARIABLES Y APLICACIÓN DEL MODELO\n",
    "# ========================================\n",
    "\n",
    "print(\"🔧 CORRIGIENDO NOMBRES DE VARIABLES Y APLICANDO MODELO\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "# Corregir nombres de variables - convertir ndvi y pri a mayúsculas para coincidir con el modelo\n",
    "if 'ndvi' in df_completo.columns and 'NDVI' not in df_completo.columns:\n",
    "    df_completo['NDVI'] = df_completo['ndvi']\n",
    "    print(\"✅ Creada columna NDVI desde ndvi\")\n",
    "\n",
    "if 'pri' in df_completo.columns and 'PRI' not in df_completo.columns:\n",
    "    df_completo['PRI'] = df_completo['pri']\n",
    "    print(\"✅ Creada columna PRI desde pri\")\n",
    "\n",
    "# Ahora verificar todas las variables del modelo original\n",
    "print(f\"\\n🔍 VERIFICANDO VARIABLES CORREGIDAS:\")\n",
    "variables_modelo_completas = ['TA_1_1_1', 'RH_1_1_1', 'VPD_PI', 'SW_IN_1_1_1', 'LW_IN', 'P', 'WS', 'NDVI', 'PRI', 'doy', 'hour']\n",
    "variables_disponibles_final = []\n",
    "variables_faltantes_final = []\n",
    "\n",
    "for var in variables_modelo_completas:\n",
    "    if var in df_completo.columns:\n",
    "        valores_validos = df_completo[var].notna().sum()\n",
    "        variables_disponibles_final.append(var)\n",
    "        print(f\"   ✅ {var}: {valores_validos:,} valores válidos\")\n",
    "    else:\n",
    "        variables_faltantes_final.append(var)\n",
    "        print(f\"   ❌ {var}: NO DISPONIBLE\")\n",
    "\n",
    "print(f\"\\n🎯 VARIABLES FINALES PARA PREDICCIÓN: {len(variables_disponibles_final)}/{len(variables_modelo_completas)}\")\n",
    "\n",
    "# Preparar datos para predicción\n",
    "df_para_prediccion = df_completo[df_completo['NDVI'].notna()].copy()\n",
    "X_nuevos = df_para_prediccion[variables_disponibles_final].copy()\n",
    "\n",
    "print(f\"\\n📊 DATOS LISTOS PARA PREDICCIÓN:\")\n",
    "print(f\"   • Registros: {len(X_nuevos):,}\")\n",
    "print(f\"   • Variables: {len(variables_disponibles_final)}\")\n",
    "print(f\"   • Forma: {X_nuevos.shape}\")\n",
    "\n",
    "# Verificar y aplicar escalado si está disponible\n",
    "if 'scaler' in globals():\n",
    "    print(f\"\\n🔄 APLICANDO ESCALADO...\")\n",
    "    X_nuevos_scaled = scaler.transform(X_nuevos)\n",
    "    print(f\"   ✅ Datos escalados aplicados\")\n",
    "    usar_datos_escalados = True\n",
    "else:\n",
    "    print(f\"\\n⚠️ Usando datos sin escalar\")\n",
    "    X_nuevos_scaled = X_nuevos.values\n",
    "    usar_datos_escalados = False\n",
    "\n",
    "# Aplicar el modelo principal para generar predicciones\n",
    "print(f\"\\n🔮 GENERANDO PREDICCIONES...\")\n",
    "\n",
    "if 'modelo' in globals():\n",
    "    try:\n",
    "        if usar_datos_escalados:\n",
    "            predicciones_nee = modelo.predict(X_nuevos_scaled)\n",
    "        else:\n",
    "            predicciones_nee = modelo.predict(X_nuevos)\n",
    "        \n",
    "        print(f\"✅ Predicciones generadas exitosamente\")\n",
    "        print(f\"   • Modelo usado: {type(modelo).__name__}\")\n",
    "        print(f\"   • Predicciones: {len(predicciones_nee):,}\")\n",
    "        \n",
    "        # Añadir predicciones al DataFrame\n",
    "        df_para_prediccion['NEE_predicho'] = predicciones_nee\n",
    "        \n",
    "        # Estadísticas de las predicciones\n",
    "        print(f\"\\n📊 ESTADÍSTICAS DE PREDICCIONES NEE:\")\n",
    "        print(f\"   • Promedio: {predicciones_nee.mean():.4f}\")\n",
    "        print(f\"   • Mínimo: {predicciones_nee.min():.4f}\")\n",
    "        print(f\"   • Máximo: {predicciones_nee.max():.4f}\")\n",
    "        print(f\"   • Desviación estándar: {predicciones_nee.std():.4f}\")\n",
    "        \n",
    "        # Análisis por ubicaciones\n",
    "        print(f\"\\n📍 ANÁLISIS POR COORDENADAS:\")\n",
    "        nee_por_ubicacion = df_para_prediccion.groupby(['latitude', 'longitude'])['NEE_predicho'].agg(['mean', 'std', 'count'])\n",
    "        print(f\"   • Ubicaciones procesadas: {len(nee_por_ubicacion)}\")\n",
    "        print(f\"   • Predicciones por ubicación: {nee_por_ubicacion['count'].iloc[0]:,}\")\n",
    "        \n",
    "        print(f\"\\n🌱 NEE PROMEDIO POR UBICACIÓN:\")\n",
    "        nee_ordenado = nee_por_ubicacion.sort_values('mean')\n",
    "        print(f\"   • Menor NEE: {nee_ordenado['mean'].iloc[0]:.4f} en ({nee_ordenado.index[0][0]:.2f}, {nee_ordenado.index[0][1]:.2f})\")\n",
    "        print(f\"   • Mayor NEE: {nee_ordenado['mean'].iloc[-1]:.4f} en ({nee_ordenado.index[-1][0]:.2f}, {nee_ordenado.index[-1][1]:.2f})\")\n",
    "        \n",
    "        # Guardar resultados\n",
    "        archivo_predicciones = 'predicciones_nee_satelital.csv'\n",
    "        df_para_prediccion[['valid_time', 'latitude', 'longitude', 'NDVI', 'PRI', 'NEE_predicho']].to_csv(archivo_predicciones, index=False)\n",
    "        \n",
    "        print(f\"\\n💾 PREDICCIONES GUARDADAS:\")\n",
    "        print(f\"   • Archivo: {archivo_predicciones}\")\n",
    "        print(f\"   • Registros: {len(df_para_prediccion):,}\")\n",
    "        \n",
    "        print(f\"\\n✅ APLICACIÓN DEL MODELO COMPLETADA\")\n",
    "        print(f\"   • Predicciones NEE generadas para todos los datos satelitales\")\n",
    "        print(f\"   • Variable: df_para_prediccion (incluye columna NEE_predicho)\")\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f\"❌ Error al aplicar el modelo: {e}\")\n",
    "        print(f\"   Verificando compatibilidad de dimensiones...\")\n",
    "        print(f\"   Datos de entrada: {X_nuevos.shape}\")\n",
    "        if hasattr(modelo, 'n_features_in_'):\n",
    "            print(f\"   Modelo espera: {modelo.n_features_in_} características\")\n",
    "        raise\n",
    "\n",
    "else:\n",
    "    print(f\"❌ Modelo principal no disponible\")\n",
    "    print(f\"   Verifica que se haya entrenado correctamente\")"
   ]
  },

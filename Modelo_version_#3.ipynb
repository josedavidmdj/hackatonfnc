    "# ========================================\n",
    "# ANÁLISIS DETALLADO DE LA ESTRUCTURA DE DATOS ERA5\n",
    "# ========================================\n",
    "\n",
    "# Verificar si df_era5 está definido\n",
    "try:\n",
    "    df_era5_exists = 'df_era5' in locals() or 'df_era5' in globals()\n",
    "    if not df_era5_exists:\n",
    "        # Intentar cargar los datos si no están cargados\n",
    "        print(\"⚠️ df_era5 no está definido. Intentando cargar los datos...\")\n",
    "        import pandas as pd\n",
    "        df_era5 = pd.read_excel(\"datos_meteorologicos_era5land_solo_2018.xlsx\")\n",
    "        print(\"✅ Datos ERA5 cargados exitosamente\")\n",
    "except Exception as e:\n",
    "    print(f\"❌ Error al cargar datos ERA5: {e}\")\n",
    "    print(\"📋 Por favor, ejecuta primero la celda que carga df_era5\")\n",
    "    raise\n",
    "\n",
    "print(\"🔍 ANÁLISIS DETALLADO DE LOS DATOS ERA5-Land\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "# 1. Información básica del dataset\n",
    "print(f\"📊 INFORMACIÓN GENERAL:\")\n",
    "print(f\"   • Forma del dataset: {df_era5.shape}\")\n",
    "print(f\"   • Filas: {df_era5.shape[0]:,}\")\n",
    "print(f\"   • Columnas: {df_era5.shape[1]}\")\n",
    "print(f\"   • Memoria utilizada: {df_era5.memory_usage(deep=True).sum() / 1024**2:.2f} MB\")\n",
    "\n",
    "# 2. Análisis detallado de columnas\n",
    "print(f\"\\n📋 ANÁLISIS DE COLUMNAS:\")\n",
    "print(f\"   • Lista completa de columnas:\")\n",
    "for i, col in enumerate(df_era5.columns, 1):\n",
    "    dtype = df_era5[col].dtype\n",
    "    non_null = df_era5[col].count()\n",
    "    null_count = df_era5[col].isnull().sum()\n",
    "    null_pct = (null_count / len(df_era5)) * 100\n",
    "    print(f\"     {i:2d}. {col:<25} | Tipo: {str(dtype):<12} | Válidos: {non_null:,} | NaN: {null_count:,} ({null_pct:.1f}%)\")\n",
    "\n",
    "# 3. Identificar columna temporal\n",
    "columnas_tiempo = []\n",
    "for col in df_era5.columns:\n",
    "    if any(palabra in col.lower() for palabra in ['time', 'fecha', 'date', 'tiempo', 'timestamp']):\n",
    "        columnas_tiempo.append(col)\n",
    "\n",
    "print(f\"\\n⏰ COLUMNAS TEMPORALES IDENTIFICADAS:\")\n",
    "if columnas_tiempo:\n",
    "    for col in columnas_tiempo:\n",
    "        print(f\"   • {col}\")\n",
    "        if df_era5[col].dtype == 'object':\n",
    "            print(f\"     Primeros valores: {df_era5[col].head(3).tolist()}\")\n",
    "            print(f\"     Últimos valores: {df_era5[col].tail(3).tolist()}\")\n",
    "        else:\n",
    "            print(f\"     Rango: {df_era5[col].min()} → {df_era5[col].max()}\")\n",
    "else:\n",
    "    print(\"   ⚠️ No se identificaron columnas temporales obvias\")\n",
    "    print(f\"   Verificando primera columna: {df_era5.columns[0]}\")\n",
    "    primera_col = df_era5.iloc[:, 0]\n",
    "    print(f\"   Tipo: {primera_col.dtype}\")\n",
    "    print(f\"   Primeros valores: {primera_col.head(3).tolist()}\")\n",
    "\n",
    "# 4. Análisis de variables numéricas\n",
    "num_cols = df_era5.select_dtypes(include=['number']).columns\n",
    "print(f\"\\n🔢 VARIABLES NUMÉRICAS ({len(num_cols)} variables):\")\n",
    "for col in num_cols:\n",
    "    serie = df_era5[col]\n",
    "    print(f\"\\n   📊 {col}:\")\n",
    "    print(f\"      • Rango: {serie.min():.3f} → {serie.max():.3f}\")\n",
    "    print(f\"      • Media: {serie.mean():.3f} ± {serie.std():.3f}\")\n",
    "    print(f\"      • Mediana: {serie.median():.3f}\")\n",
    "    print(f\"      • Valores únicos: {serie.nunique():,}\")\n",
    "    \n",
    "    # Detectar posibles unidades basándose en rangos\n",
    "    if 'temp' in col.lower() or 't2m' in col.lower():\n",
    "        if serie.min() > 200:\n",
    "            print(f\"      • Posible unidad: Kelvin (rango típico 200-350K)\")\n",
    "        elif -50 < serie.min() < 50:\n",
    "            print(f\"      • Posible unidad: Celsius (rango típico -50 a 50°C)\")\n",
    "    elif 'precip' in col.lower() or 'rain' in col.lower() or 'tp' in col.lower():\n",
    "        print(f\"      • Posible unidad: mm o m (precipitación)\")\n",
    "    elif 'wind' in col.lower() or 'ws' in col.lower():\n",
    "        print(f\"      • Posible unidad: m/s (velocidad viento)\")\n",
    "    elif 'pressure' in col.lower() or 'pa' in col.lower():\n",
    "        if serie.min() > 50000:\n",
    "            print(f\"      • Posible unidad: Pa (pascales)\")\n",
    "        elif 900 < serie.min() < 1100:\n",
    "            print(f\"      • Posible unidad: hPa o mbar\")\n",
    "    elif 'rad' in col.lower() or 'solar' in col.lower():\n",
    "        print(f\"      • Posible unidad: W/m² (radiación)\")\n",
    "\n",
    "# 5. Análisis de variables categóricas/texto\n",
    "cat_cols = df_era5.select_dtypes(include=['object', 'category']).columns\n",
    "if len(cat_cols) > 0:\n",
    "    print(f\"\\n📝 VARIABLES CATEGÓRICAS/TEXTO ({len(cat_cols)} variables):\")\n",
    "    for col in cat_cols:\n",
    "        serie = df_era5[col]\n",
    "        valores_unicos = serie.nunique()\n",
    "        print(f\"\\n   📋 {col}:\")\n",
    "        print(f\"      • Valores únicos: {valores_unicos:,}\")\n",
    "        if valores_unicos <= 10:\n",
    "            print(f\"      • Valores: {serie.unique().tolist()}\")\n",
    "        else:\n",
    "            print(f\"      • Primeros 5: {serie.unique()[:5].tolist()}\")\n",
    "            print(f\"      • Últimos 5: {serie.unique()[-5:].tolist()}\")\n",
    "\n",
    "# 6. Análisis de patrones temporales (si existe columna temporal)\n",
    "if len(columnas_tiempo) > 0 or 'index' in str(type(df_era5.index)).lower():\n",
    "    print(f\"\\n📅 ANÁLISIS DE PATRONES TEMPORALES:\")\n",
    "    \n",
    "    # Si el índice es datetime\n",
    "    if pd.api.types.is_datetime64_any_dtype(df_era5.index):\n",
    "        fechas = df_era5.index\n",
    "        print(f\"   • Usando índice como columna temporal\")\n",
    "    elif len(columnas_tiempo) > 0:\n",
    "        col_tiempo = columnas_tiempo[0]\n",
    "        try:\n",
    "            fechas = pd.to_datetime(df_era5[col_tiempo])\n",
    "            print(f\"   • Usando columna '{col_tiempo}' como temporal\")\n",
    "        except:\n",
    "            print(f\"   ⚠️ No se pudo convertir '{col_tiempo}' a datetime\")\n",
    "            fechas = None\n",
    "    else:\n",
    "        fechas = None\n",
    "    \n",
    "    if fechas is not None:\n",
    "        print(f\"   • Período: {fechas.min()} → {fechas.max()}\")\n",
    "        print(f\"   • Duración: {(fechas.max() - fechas.min()).days} días\")\n",
    "        \n",
    "        # Calcular frecuencia de mediciones\n",
    "        if len(fechas) > 1:\n",
    "            diferencias = fechas.diff().dropna()\n",
    "            freq_mas_common = diferencias.mode()\n",
    "            if len(freq_mas_common) > 0:\n",
    "                freq_horas = freq_mas_common.iloc[0].total_seconds() / 3600\n",
    "                print(f\"   • Frecuencia más común: {freq_horas:.1f} horas\")\n",
    "                \n",
    "                # Evitar división por cero\n",
    "                if freq_horas > 0:\n",
    "                    print(f\"   • Registros por día (aprox): {24/freq_horas:.1f}\")\n",
    "                else:\n",
    "                    print(f\"   • ⚠️ Frecuencia de 0 horas detectada (posibles registros duplicados)\")\n",
    "        \n",
    "        # Análisis de completitud temporal\n",
    "        rango_completo = pd.date_range(fechas.min(), fechas.max(), freq='H')\n",
    "        cobertura = (len(fechas) / len(rango_completo)) * 100\n",
    "        print(f\"   • Cobertura temporal: {cobertura:.1f}% (asumiendo datos horarios)\")\n",
    "\n",
    "# 7. Resumen de compatibilidad con el modelo entrenado\n",
    "print(f\"\\n🎯 COMPATIBILIDAD CON EL MODELO ENTRENADO:\")\n",
    "\n",
    "# Verificar si variables_entrada está definida\n",
    "try:\n",
    "    variables_del_modelo = variables_entrada\n",
    "    print(f\"   Variables del modelo original: {variables_del_modelo}\")\n",
    "except NameError:\n",
    "    # Variables típicas del modelo si no está definida la variable\n",
    "    variables_del_modelo = [\n",
    "        'TA_1_1_1', 'RH_1_1_1', 'VPD_PI', 'SW_IN_1_1_1', \n",
    "        'LW_IN', 'WS', 'NDVI', 'PRI', 'doy', 'hour'\n",
    "    ]\n",
    "    print(f\"   Variables típicas del modelo: {variables_del_modelo}\")\n",
    "    print(f\"   (Nota: usando variables típicas, ejecuta celdas anteriores para usar las exactas)\")\n",
    "\n",
    "print(f\"   Variables disponibles en ERA5:\")\n",
    "\n",
    "for var_modelo in variables_del_modelo:\n",
    "    encontrada = False\n",
    "    posibles_matches = []\n",

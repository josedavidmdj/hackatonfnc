    "# ========================================\n",
    "# ANÁLISIS DE FRECUENCIA TEMPORAL - DÍA Y HORA\n",
    "# ========================================\n",
    "\n",
    "print(\"📅 ANÁLISIS DE FRECUENCIA TEMPORAL DEL DATASET\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "# Análisis de frecuencia por día de la semana\n",
    "df_modelo['dia_semana'] = df_modelo['TIMESTAMP_START'].dt.day_name()\n",
    "df_modelo['numero_dia_semana'] = df_modelo['TIMESTAMP_START'].dt.dayofweek\n",
    "\n",
    "# Análisis de frecuencia por hora\n",
    "df_modelo['hora_entera'] = df_modelo['TIMESTAMP_START'].dt.hour\n",
    "\n",
    "# Crear figura con múltiples subplots para análisis temporal\n",
    "fig, axes = plt.subplots(2, 3, figsize=(20, 12))\n",
    "fig.suptitle('📊 ANÁLISIS DE FRECUENCIA TEMPORAL DEL DATASET', fontsize=16, fontweight='bold')\n",
    "\n",
    "# 1. Frecuencia por día de la semana\n",
    "ax1 = axes[0, 0]\n",
    "freq_dia_semana = df_modelo['dia_semana'].value_counts().reindex([\n",
    "    'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'\n",
    "])\n",
    "dias_esp = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo']\n",
    "ax1.bar(dias_esp, freq_dia_semana.values, color='steelblue', alpha=0.7)\n",
    "ax1.set_title('📅 Frecuencia por Día de la Semana', fontsize=12, fontweight='bold')\n",
    "ax1.set_ylabel('Número de registros')\n",
    "ax1.tick_params(axis='x', rotation=45)\n",
    "ax1.grid(True, alpha=0.3)\n",
    "\n",
    "# Agregar valores encima de las barras\n",
    "for i, v in enumerate(freq_dia_semana.values):\n",
    "    ax1.text(i, v + 10, str(v), ha='center', va='bottom', fontweight='bold')\n",
    "\n",
    "# 2. Frecuencia por hora del día\n",
    "ax2 = axes[0, 1]\n",
    "freq_hora = df_modelo['hora_entera'].value_counts().sort_index()\n",
    "ax2.bar(freq_hora.index, freq_hora.values, color='darkgreen', alpha=0.7)\n",
    "ax2.set_title('🕐 Frecuencia por Hora del Día', fontsize=12, fontweight='bold')\n",
    "ax2.set_xlabel('Hora del día')\n",
    "ax2.set_ylabel('Número de registros')\n",
    "ax2.grid(True, alpha=0.3)\n",
    "\n",
    "# 3. Mapa de calor: día de semana vs hora\n",
    "ax3 = axes[0, 2]\n",
    "heatmap_data = df_modelo.groupby(['numero_dia_semana', 'hora_entera']).size().unstack(fill_value=0)\n",
    "im = ax3.imshow(heatmap_data.values, cmap='YlOrRd', aspect='auto')\n",
    "ax3.set_title('🔥 Mapa de Calor: Día vs Hora', fontsize=12, fontweight='bold')\n",
    "ax3.set_xlabel('Hora del día')\n",
    "ax3.set_ylabel('Día de la semana')\n",
    "ax3.set_yticks(range(7))\n",
    "ax3.set_yticklabels(dias_esp)\n",
    "ax3.set_xticks(range(0, 24, 2))\n",
    "ax3.set_xticklabels(range(0, 24, 2))\n",
    "plt.colorbar(im, ax=ax3, label='Número de registros')\n",
    "\n",
    "# 4. Frecuencia por mes\n",
    "ax4 = axes[1, 0]\n",
    "freq_mes = df_modelo['month'].value_counts().sort_index()\n",
    "meses_esp = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', \n",
    "             'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic']\n",
    "ax4.bar(range(1, 13), [freq_mes.get(i, 0) for i in range(1, 13)], \n",
    "        color='purple', alpha=0.7)\n",
    "ax4.set_title('📆 Frecuencia por Mes', fontsize=12, fontweight='bold')\n",
    "ax4.set_xlabel('Mes')\n",
    "ax4.set_ylabel('Número de registros')\n",
    "ax4.set_xticks(range(1, 13))\n",
    "ax4.set_xticklabels(meses_esp)\n",
    "ax4.grid(True, alpha=0.3)\n",
    "\n",
    "# 5. Frecuencia por año\n",
    "ax5 = axes[1, 1]\n",
    "freq_año = df_modelo['year'].value_counts().sort_index()\n",
    "ax5.bar(freq_año.index, freq_año.values, color='orange', alpha=0.7)\n",
    "ax5.set_title('📈 Frecuencia por Año', fontsize=12, fontweight='bold')\n",
    "ax5.set_xlabel('Año')\n",
    "ax5.set_ylabel('Número de registros')\n",
    "ax5.grid(True, alpha=0.3)\n",
    "\n",
    "# Agregar valores encima de las barras\n",
    "for i, (año, freq) in enumerate(freq_año.items()):\n",
    "    ax5.text(año, freq + 50, str(freq), ha='center', va='bottom', fontweight='bold')\n",
    "\n",
    "# 6. Distribución de intervalos temporales\n",
    "ax6 = axes[1, 2]\n",
    "df_sorted_temp = df_modelo.sort_values('TIMESTAMP_START').reset_index(drop=True)\n",
    "intervalos = df_sorted_temp['TIMESTAMP_START'].diff().dt.total_seconds() / 60  # en minutos\n",
    "intervalos_valid = intervalos[intervalos.notna() & (intervalos > 0) & (intervalos <= 120)]  # filtrar outliers\n",
    "\n",
    "ax6.hist(intervalos_valid, bins=30, color='red', alpha=0.7, edgecolor='black')\n",
    "ax6.set_title('⏰ Distribución de Intervalos Temporales', fontsize=12, fontweight='bold')\n",
    "ax6.set_xlabel('Intervalo (minutos)')\n",
    "ax6.set_ylabel('Frecuencia')\n",
    "ax6.axvline(30, color='blue', linestyle='--', linewidth=2, label='30 min (esperado)')\n",
    "ax6.legend()\n",
    "ax6.grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Estadísticas detalladas\n",
    "print(f\"\\n📊 ESTADÍSTICAS DE FRECUENCIA TEMPORAL:\")\n",
    "print(f\"=\"*50)\n",
    "\n",
    "print(f\"\\n🕐 DISTRIBUCIÓN POR HORA:\")\n",
    "for hora, freq in freq_hora.head(10).items():\n",
    "    porcentaje = (freq / len(df_modelo)) * 100\n",
    "    print(f\"   Hora {hora:2d}:00 → {freq:,} registros ({porcentaje:.1f}%)\")\n",
    "\n",
    "print(f\"\\n📅 DISTRIBUCIÓN POR DÍA DE LA SEMANA:\")\n",
    "for i, (dia_eng, dia_esp) in enumerate(zip(freq_dia_semana.index, dias_esp)):\n",
    "    freq = freq_dia_semana.iloc[i]\n",
    "    porcentaje = (freq / len(df_modelo)) * 100\n",
    "    print(f\"   {dia_esp:10s} → {freq:,} registros ({porcentaje:.1f}%)\")\n",
    "\n",
    "print(f\"\\n📆 DISTRIBUCIÓN POR MES:\")\n",
    "for mes in range(1, 13):\n",
    "    freq = freq_mes.get(mes, 0)\n",
    "    porcentaje = (freq / len(df_modelo)) * 100 if freq > 0 else 0\n",
    "    print(f\"   {meses_esp[mes-1]:10s} → {freq:,} registros ({porcentaje:.1f}%)\")\n",
    "\n",
    "print(f\"\\n📈 DISTRIBUCIÓN POR AÑO:\")\n",
    "for año, freq in freq_año.items():\n",
    "    porcentaje = (freq / len(df_modelo)) * 100\n",
    "    print(f\"   {año} → {freq:,} registros ({porcentaje:.1f}%)\")\n",
    "\n",
    "print(f\"\\n⏰ ESTADÍSTICAS DE INTERVALOS TEMPORALES:\")\n",
    "if len(intervalos_valid) > 0:\n",
    "    print(f\"   Intervalo promedio: {intervalos_valid.mean():.1f} minutos\")\n",
    "    print(f\"   Intervalo mediano: {intervalos_valid.median():.1f} minutos\")\n",
    "    print(f\"   Intervalo más común: {intervalos_valid.mode().iloc[0]:.1f} minutos\")\n",
    "    print(f\"   Desviación estándar: {intervalos_valid.std():.1f} minutos\")\n",
    "    print(f\"   Rango: {intervalos_valid.min():.1f} - {intervalos_valid.max():.1f} minutos\")\n",
    "\n",
    "# Análisis de huecos temporales\n",
    "print(f\"\\n🚨 ANÁLISIS DE HUECOS TEMPORALES:\")\n",
    "huecos_grandes = intervalos[intervalos > 60]  # huecos mayores a 1 hora\n",
    "if len(huecos_grandes) > 0:\n",
    "    print(f\"   Huecos > 1 hora: {len(huecos_grandes)} eventos\")\n",
    "    print(f\"   Hueco más grande: {huecos_grandes.max():.1f} minutos ({huecos_grandes.max()/60:.1f} horas)\")\n",
    "    print(f\"   Duración total de huecos: {huecos_grandes.sum():.1f} minutos ({huecos_grandes.sum()/60:.1f} horas)\")\n",
    "else:\n",
    "    print(f\"   ✅ No se encontraron huecos mayores a 1 hora\")\n",
    "\n",
    "# Resumen de consistencia temporal\n",
    "registros_esperados_30min = (df_modelo['TIMESTAMP_START'].max() - df_modelo['TIMESTAMP_START'].min()).total_seconds() / (30 * 60)\n",
    "cobertura_temporal = (len(df_modelo) / registros_esperados_30min) * 100\n",
    "\n",
    "print(f\"\\n📋 RESUMEN DE CONSISTENCIA TEMPORAL:\")\n",
    "print(f\"   Registros observados: {len(df_modelo):,}\")\n",
    "print(f\"   Registros esperados (cada 30 min): {registros_esperados_30min:.0f}\")\n",
    "print(f\"   Cobertura temporal: {cobertura_temporal:.1f}%\")\n",
    "print(f\"   Registros faltantes: {registros_esperados_30min - len(df_modelo):.0f}\")"
   ]

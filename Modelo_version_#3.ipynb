    "# ========================================\n",
    "# CONVERSIÓN DE UNIDADES: µmol CO₂/m²/s → tCO₂/ha/año\n",
    "# ========================================\n",
    "\n",
    "print(\"🔄 CONVIRTIENDO UNIDADES DEL NEE...\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "# Factores de conversión\n",
    "print(\"📐 FACTORES DE CONVERSIÓN:\")\n",
    "\n",
    "# 1. µmol CO₂ → gramos CO₂\n",
    "# Peso molecular del CO₂ = 44.01 g/mol\n",
    "# 1 mol = 1,000,000 µmol\n",
    "peso_molecular_co2 = 44.01  # g/mol\n",
    "factor_umol_a_g = peso_molecular_co2 / 1_000_000  # g/µmol\n",
    "print(f\"• µmol CO₂ → g CO₂: {factor_umol_a_g:.2e} g/µmol\")\n",
    "\n",
    "# 2. m² → hectárea\n",
    "# 1 hectárea = 10,000 m²\n",
    "factor_m2_a_ha = 10_000  # m²/ha\n",
    "print(f\"• m² → hectárea: {factor_m2_a_ha:,} m²/ha\")\n",
    "\n",
    "# 3. segundos → año\n",
    "# 1 año = 365.25 días × 24 horas × 3600 segundos\n",
    "segundos_por_año = 365.25 * 24 * 3600  # segundos/año\n",
    "print(f\"• segundos → año: {segundos_por_año:,.0f} segundos/año\")\n",
    "\n",
    "# 4. gramos → toneladas\n",
    "# 1 tonelada = 1,000,000 gramos\n",
    "factor_g_a_t = 1_000_000  # g/t\n",
    "print(f\"• gramos → toneladas: {factor_g_a_t:,} g/t\")\n",
    "\n",
    "# Factor de conversión total\n",
    "# µmol CO₂/m²/s × (44.01 g/mol) / (1×10⁶ µmol/mol) × (10⁴ m²/ha) × (365.25×24×3600 s/año) / (10⁶ g/t)\n",
    "factor_conversion_total = (peso_molecular_co2 / 1_000_000) * factor_m2_a_ha * segundos_por_año / factor_g_a_t\n",
    "print(f\"\\n🔢 FACTOR DE CONVERSIÓN TOTAL:\")\n",
    "print(f\"• µmol CO₂/m²/s → tCO₂/ha/año: {factor_conversion_total:.6f}\")\n",
    "\n",
    "print(f\"\\n📋 FÓRMULA DE CONVERSIÓN:\")\n",
    "print(f\"tCO₂/ha/año = µmol CO₂/m²/s × {factor_conversion_total:.6f}\")\n",
    "\n",
    "# ========================================\n",
    "# APLICAR CONVERSIÓN A LOS DATOS\n",
    "# ========================================\n",
    "\n",
    "print(f\"\\n🧮 APLICANDO CONVERSIÓN A LOS DATOS...\")\n",
    "\n",
    "# Convertir datos de predicciones\n",
    "df_predicciones['nee_t_co2_ha_año'] = df_predicciones[columna_nee] * factor_conversion_total\n",
    "\n",
    "print(f\"✅ Conversión completada\")\n",
    "print(f\"📊 Nueva columna creada: 'nee_t_co2_ha_año'\")\n",
    "\n",
    "# Estadísticas en nuevas unidades\n",
    "print(f\"\\n🌱 ESTADÍSTICAS NEE EN tCO₂/ha/año:\")\n",
    "print(f\"• Promedio: {df_predicciones['nee_t_co2_ha_año'].mean():.4f} tCO₂/ha/año\")\n",
    "print(f\"• Desviación estándar: {df_predicciones['nee_t_co2_ha_año'].std():.4f}\")\n",
    "print(f\"• Mínimo: {df_predicciones['nee_t_co2_ha_año'].min():.4f}\")\n",
    "print(f\"• Máximo: {df_predicciones['nee_t_co2_ha_año'].max():.4f}\")\n",
    "print(f\"• Mediana: {df_predicciones['nee_t_co2_ha_año'].median():.4f}\")\n",
    "\n",
    "# Balance anual total\n",
    "balance_anual_total = df_predicciones['nee_t_co2_ha_año'].sum()\n",
    "print(f\"\\n🌍 BALANCE ANUAL TOTAL:\")\n",
    "print(f\"• Balance neto: {balance_anual_total:.2f} tCO₂/ha/año\")\n",
    "\n",
    "# Interpretación del signo\n",
    "if balance_anual_total < 0:\n",
    "    print(f\"• Interpretación: ABSORCIÓN NETA ({abs(balance_anual_total):.2f} tCO₂/ha absorbidas)\")\n",
    "    print(f\"• El ecosistema actúa como SUMIDERO de carbono\")\n",
    "else:\n",
    "    print(f\"• Interpretación: EMISIÓN NETA ({balance_anual_total:.2f} tCO₂/ha emitidas)\")\n",
    "    print(f\"• El ecosistema actúa como FUENTE de carbono\")\n",
    "\n",
    "# ========================================\n",
    "# RECALCULAR PROMEDIOS MENSUALES Y ANUALES EN NUEVAS UNIDADES\n",
    "# ========================================\n",
    "\n",

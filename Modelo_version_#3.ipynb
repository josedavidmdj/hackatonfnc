    "    \n",
    "    print(f\"\\n🔄 PREPARANDO DATOS PARA FUSIÓN:\")\n",
    "    print(f\"   • Columnas satelitales: {list(df_sat_para_fusion.columns)}\")\n",
    "    print(f\"   • Columnas ERA5: {list(df_era5.columns)}\")\n",
    "    \n",
    "    # Fusionar los datos basándose en coordenadas\n",
    "    print(f\"\\n🔗 REALIZANDO FUSIÓN POR COORDENADAS...\")\n",
    "    \n",
    "    # Hacer merge basado en latitud y longitud\n",
    "    df_completo = df_era5.merge(\n",

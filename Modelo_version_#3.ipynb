    "# Tomar NDVI y aplanarlo (ravel)\n",
    "ndvi_raveled = np.ravel(ndvi)\n",
    "\n",
    "# Crear un DataFrame donde la columna 'NDVI' es el ndvi_raveled\n",
    "# y el resto de columnas son la misma fila repetida\n",
    "row_dict = row.to_dict()\n",
    "n_pixels = ndvi_raveled.shape[0]\n",
    "\n",
    "# Crear DataFrame base con la fila repetida\n",
    "df_pixels = pd.DataFrame([row_dict] * n_pixels)\n",
    "\n",
    "# Reemplazar la columna NDVI por el array ravel\n",
    "df_pixels['NDVI'] = ndvi_raveled\n",
    "\n",
    "df_pixels.reset_index(drop=True, inplace=True)\n",
    "df_pixels.head()"

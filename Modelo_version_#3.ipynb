    "# ========================================\n",
    "# DESCARGA MASIVA DE DATOS SENTINEL-2 PARA TODA LA GRILLA\n",
    "# ========================================\n",
    "\n",
    "print(\"🚀 INICIANDO DESCARGA MASIVA DE DATOS SENTINEL-2\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "import ee\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from datetime import datetime, timedelta\n",
    "import time\n",
    "\n",
    "try:\n",
    "    # Verificar que GEE esté inicializado\n",
    "    if 'PROJECT_ID' in globals():\n",
    "        ee.Initialize(project=PROJECT_ID)\n",
    "        print(f\"✅ Google Earth Engine inicializado con proyecto: {PROJECT_ID}\")\n",
    "    else:\n",
    "        ee.Initialize()\n",
    "        print(\"✅ Google Earth Engine inicializado\")\n",
    "    \n",
    "    # Configuración del procesamiento masivo\n",
    "    BUFFER_METROS_GRILLA = 500  # Radio para cada punto\n",
    "    LIMITE_NUBES = 30  # % máximo de nubes\n",
    "    PERIODO_INICIO = '2018-01-01'\n",
    "    PERIODO_FIN = '2018-12-31'\n",
    "    \n",
    "    print(f\"\\n⚙️ CONFIGURACIÓN DE DESCARGA:\")\n",
    "    print(f\"   • Buffer por punto: {BUFFER_METROS_GRILLA} metros\")\n",
    "    print(f\"   • Límite de nubes: {LIMITE_NUBES}%\")\n",
    "    print(f\"   • Período: {PERIODO_INICIO} a {PERIODO_FIN}\")\n",
    "    print(f\"   • Ubicaciones a procesar: {len(coords_para_procesar)}\")\n",
    "    \n",
    "    # Función para procesar una ubicación específica\n",
    "    def procesar_ubicacion(lat, lon, ubicacion_id):\n",
    "        \"\"\"\n",
    "        Procesa una ubicación específica y retorna los datos satelitales\n",
    "        \"\"\"\n",
    "        try:\n",
    "            # Crear geometría del área de interés\n",
    "            punto = ee.Geometry.Point([lon, lat])\n",
    "            area = punto.buffer(BUFFER_METROS_GRILLA)\n",
    "            \n",
    "            # Buscar imágenes Sentinel-2\n",
    "            sentinel2_collection = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED') \\\n",
    "                .filterDate(PERIODO_INICIO, PERIODO_FIN) \\\n",
    "                .filterBounds(area) \\\n",
    "                .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', LIMITE_NUBES))\n",
    "            \n",
    "            num_imagenes = sentinel2_collection.size().getInfo()\n",
    "            \n",
    "            if num_imagenes == 0:\n",
    "                return None  # No hay imágenes para esta ubicación\n",
    "            \n",
    "            # Seleccionar la imagen con menos nubes\n",
    "            imagen_mejor = sentinel2_collection.sort('CLOUDY_PIXEL_PERCENTAGE').first()\n",
    "            \n",
    "            # Obtener metadatos de la imagen\n",
    "            fecha_imagen = ee.Date(imagen_mejor.get('system:time_start')).format('YYYY-MM-dd').getInfo()\n",
    "            nubes_imagen = imagen_mejor.get('CLOUDY_PIXEL_PERCENTAGE').getInfo()\n",
    "            \n",
    "            # Calcular índices NDVI y PRI\n",
    "            def calcular_indices(image):\n",
    "                ndvi = image.normalizedDifference(['B8', 'B4']).rename('NDVI')\n",
    "                pri = image.normalizedDifference(['B3', 'B2']).rename('PRI')\n",
    "                return image.addBands([ndvi, pri])\n",
    "            \n",
    "            imagen_con_indices = calcular_indices(imagen_mejor)\n",
    "            \n",
    "            # Extraer valores promedio para el área\n",
    "            valores = imagen_con_indices.select(['NDVI', 'PRI']).reduceRegion(\n",
    "                reducer=ee.Reducer.mean(),\n",
    "                geometry=area,\n",
    "                scale=10,\n",
    "                maxPixels=1e9\n",
    "            ).getInfo()\n",
    "            \n",
    "            if not valores or 'NDVI' not in valores or valores['NDVI'] is None:\n",
    "                return None\n",
    "            \n",
    "            # Retornar diccionario con los datos\n",
    "            return {\n",
    "                'ubicacion_id': ubicacion_id,\n",
    "                'latitud': lat,\n",
    "                'longitud': lon,\n",
    "                'fecha_imagen': fecha_imagen,\n",
    "                'ndvi': valores['NDVI'],\n",
    "                'pri': valores['PRI'],\n",
    "                'nubes_porcentaje': nubes_imagen,\n",
    "                'num_imagenes_disponibles': num_imagenes,\n",
    "                'buffer_metros': BUFFER_METROS_GRILLA,\n",
    "                'tipo_dato': 'REAL',\n",
    "                'fuente': 'Sentinel-2_MASIVO'\n",
    "            }\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"   ⚠️ Error en ubicación {ubicacion_id} ({lat:.2f}, {lon:.2f}): {e}\")\n",
    "            return None\n",
    "    \n",
    "    # Procesar todas las ubicaciones\n",
    "    print(f\"\\n🔄 PROCESANDO {len(coords_para_procesar)} UBICACIONES...\")\n",
    "    print(f\"⏱️ Esto puede tomar varios minutos...\")\n",
    "    \n",
    "    resultados_satelitales = []\n",
    "    ubicaciones_exitosas = 0\n",
    "    ubicaciones_fallidas = 0\n",
    "    \n",
    "    inicio_proceso = time.time()\n",
    "    \n",
    "    for idx, (_, row) in enumerate(coords_para_procesar.iterrows(), 1):\n",
    "        lat, lon = row['latitud'], row['longitud']\n",
    "        \n",
    "        # Mostrar progreso cada 5 ubicaciones\n",
    "        if idx % 5 == 0 or idx == 1:\n",
    "            tiempo_transcurrido = time.time() - inicio_proceso\n",
    "            tiempo_por_ubicacion = tiempo_transcurrido / idx if idx > 0 else 0\n",
    "            tiempo_estimado_restante = tiempo_por_ubicacion * (len(coords_para_procesar) - idx)\n",
    "            \n",
    "            print(f\"   📍 Procesando {idx}/{len(coords_para_procesar)} - \"\n",
    "                  f\"({lat:.2f}, {lon:.2f}) - \"\n",
    "                  f\"⏱️ {tiempo_estimado_restante/60:.1f}min restantes\")\n",
    "        \n",
    "        # Procesar la ubicación\n",
    "        resultado = procesar_ubicacion(lat, lon, idx)\n",
    "        \n",
    "        if resultado:\n",
    "            resultados_satelitales.append(resultado)\n",
    "            ubicaciones_exitosas += 1\n",
    "        else:\n",
    "            ubicaciones_fallidas += 1\n",
    "        \n",
    "        # Pequeña pausa para no sobrecargar Google Earth Engine\n",
    "        time.sleep(0.1)\n",
    "    \n",
    "    # Crear DataFrame final\n",
    "    if resultados_satelitales:\n",
    "        df_satelital_completo = pd.DataFrame(resultados_satelitales)\n",
    "        \n",
    "        tiempo_total = time.time() - inicio_proceso\n",
    "        \n",
    "        print(f\"\\n✅ DESCARGA MASIVA COMPLETADA\")\n",
    "        print(f\"⏱️ Tiempo total: {tiempo_total/60:.1f} minutos\")\n",
    "        print(f\"📊 Resultados:\")\n",
    "        print(f\"   • Ubicaciones exitosas: {ubicaciones_exitosas}/{len(coords_para_procesar)} ({ubicaciones_exitosas/len(coords_para_procesar)*100:.1f}%)\")\n",
    "        print(f\"   • Ubicaciones fallidas: {ubicaciones_fallidas}\")\n",
    "        print(f\"   • Registros satelitales: {len(df_satelital_completo)}\")\n",
    "        \n",
    "        print(f\"\\n📋 PRIMEROS 5 REGISTROS:\")\n",
    "        print(df_satelital_completo.head())\n",
    "        \n",
    "        print(f\"\\n📊 ESTADÍSTICAS DE ÍNDICES:\")\n",
    "        print(f\"   • NDVI: {df_satelital_completo['ndvi'].min():.3f} - {df_satelital_completo['ndvi'].max():.3f} (promedio: {df_satelital_completo['ndvi'].mean():.3f})\")\n",
    "        print(f\"   • PRI: {df_satelital_completo['pri'].min():.3f} - {df_satelital_completo['pri'].max():.3f} (promedio: {df_satelital_completo['pri'].mean():.3f})\")\n",
    "        print(f\"   • Nubes: {df_satelital_completo['nubes_porcentaje'].min():.1f}% - {df_satelital_completo['nubes_porcentaje'].max():.1f}% (promedio: {df_satelital_completo['nubes_porcentaje'].mean():.1f}%)\")\n",
    "        \n",
    "        print(f\"\\n💾 BASE DE DATOS SATELITAL LISTA\")\n",
    "        print(f\"   • Variable: df_satelital_completo\")\n",
    "        print(f\"   • Formato: DataFrame de pandas\")\n",
    "        print(f\"   • Dimensiones: {df_satelital_completo.shape}\")\n",
    "        \n",
    "    else:\n",
    "        print(f\"❌ NO SE PUDIERON OBTENER DATOS SATELITALES\")\n",
    "        print(f\"🔧 Todas las ubicaciones fallaron - revisa la configuración\")\n",
    "        df_satelital_completo = pd.DataFrame()\n",
    "\n",
    "except Exception as e:\n",
    "    print(f\"❌ ERROR EN DESCARGA MASIVA: {e}\")\n",
    "    print(f\"🛠️ Verifica:\")\n",
    "    print(f\"   • Google Earth Engine está configurado\")\n",
    "    print(f\"   • La variable coords_para_procesar existe\")\n",
    "    print(f\"   • La conexión a internet funciona\")\n",
    "    raise"
   ]

    "# ========================================\n",
    "# ANÁLISIS FINAL Y RESUMEN DE RESULTADOS\n",
    "# ========================================\n",
    "\n",
    "print(\"📊 ANÁLISIS FINAL DE PREDICCIONES NEE\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "# Análisis temporal detallado\n",
    "df_prediccion['fecha_dt'] = pd.to_datetime(df_prediccion['valid_time'])\n",
    "df_prediccion['mes'] = df_prediccion['fecha_dt'].dt.month\n",
    "df_prediccion['hora'] = df_prediccion['fecha_dt'].dt.hour\n",
    "\n",
    "print(f\"✅ RESUMEN GENERAL:\")\n",
    "print(f\"   • Total predicciones: {len(df_prediccion):,}\")\n",
    "print(f\"   • Período: {df_prediccion['fecha_dt'].min().strftime('%Y-%m-%d')} a {df_prediccion['fecha_dt'].max().strftime('%Y-%m-%d')}\")\n",
    "print(f\"   • Ubicaciones: {df_prediccion[['latitude', 'longitude']].drop_duplicates().shape[0]}\")\n",
    "\n",
    "# Estadísticas por mes\n",
    "print(f\"\\n📅 NEE PROMEDIO POR MES:\")\n",
    "nee_mensual = df_prediccion.groupby('mes')['NEE_predicho'].agg(['mean', 'std', 'count']).round(4)\n",
    "meses_nombres = ['', 'Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', \n",
    "                 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic']\n",
    "\n",
    "for mes in range(1, 13):\n",
    "    if mes in nee_mensual.index:\n",
    "        mean_val = nee_mensual.loc[mes, 'mean']\n",
    "        std_val = nee_mensual.loc[mes, 'std']\n",
    "        print(f\"   {meses_nombres[mes]}: {mean_val:+.4f} ± {std_val:.4f}\")\n",
    "\n",
    "# Análisis por hora del día\n",
    "print(f\"\\n🕐 NEE PROMEDIO POR HORA:\")\n",
    "nee_horario = df_prediccion.groupby('hora')['NEE_predicho'].mean().round(4)\n",
    "\n",
    "# Mostrar algunas horas clave\n",
    "horas_clave = [6, 12, 18, 0]\n",
    "for hora in horas_clave:\n",
    "    if hora in nee_horario.index:\n",
    "        print(f\"   {hora:02d}:00 hrs: {nee_horario[hora]:+.4f}\")\n",
    "\n",
    "# Análisis espacial detallado\n",
    "print(f\"\\n🗺️ ANÁLISIS ESPACIAL DETALLADO:\")\n",
    "analisis_espacial = df_prediccion.groupby(['latitude', 'longitude']).agg({\n",
    "    'NEE_predicho': ['mean', 'std', 'min', 'max'],\n",
    "    'NDVI': 'mean',\n",
    "    'PRI': 'mean'\n",
    "}).round(4)\n",
    "\n",
    "# Aplanar nombres de columnas\n",
    "analisis_espacial.columns = ['_'.join(col).strip() for col in analisis_espacial.columns]\n",
    "analisis_espacial = analisis_espacial.reset_index()\n",
    "\n",
    "print(f\"   • Ubicaciones analizadas: {len(analisis_espacial)}\")\n",
    "\n",
    "# Encontrar ubicaciones extremas\n",
    "idx_min_nee = analisis_espacial['NEE_predicho_mean'].idxmin()\n",
    "idx_max_nee = analisis_espacial['NEE_predicho_mean'].idxmax()\n",
    "\n",
    "ubicacion_min = analisis_espacial.iloc[idx_min_nee]\n",
    "ubicacion_max = analisis_espacial.iloc[idx_max_nee]\n",
    "\n",
    "print(f\"\\n🌱 UBICACIONES CON NEE EXTREMO:\")\n",
    "print(f\"   📍 Menor NEE (mayor absorción CO₂):\")\n",
    "print(f\"     • Coordenadas: ({ubicacion_min['latitude']:.2f}, {ubicacion_min['longitude']:.2f})\")\n",
    "print(f\"     • NEE promedio: {ubicacion_min['NEE_predicho_mean']:+.4f}\")\n",
    "print(f\"     • NDVI: {ubicacion_min['NDVI_mean']:.3f}, PRI: {ubicacion_min['PRI_mean']:.3f}\")\n",
    "\n",
    "print(f\"   📍 Mayor NEE (mayor emisión CO₂):\")\n",
    "print(f\"     • Coordenadas: ({ubicacion_max['latitude']:.2f}, {ubicacion_max['longitude']:.2f})\")\n",
    "print(f\"     • NEE promedio: {ubicacion_max['NEE_predicho_mean']:+.4f}\")\n",
    "print(f\"     • NDVI: {ubicacion_max['NDVI_mean']:.3f}, PRI: {ubicacion_max['PRI_mean']:.3f}\")\n",
    "\n",
    "# Análisis de correlaciones con índices satelitales\n",
    "print(f\"\\n🛰️ CORRELACIONES CON DATOS SATELITALES:\")\n",
    "corr_ndvi = df_prediccion['NEE_predicho'].corr(df_prediccion['NDVI'])\n",
    "corr_pri = df_prediccion['NEE_predicho'].corr(df_prediccion['PRI'])\n",
    "\n",
    "print(f\"   • NEE vs NDVI: {corr_ndvi:+.4f}\")\n",

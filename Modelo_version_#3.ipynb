    "\n",
    "if archivo_predicciones:\n",
    "    print(f\"✅ Cargando: {archivo_predicciones}\")\n",
    "    df_predicciones = pd.read_csv(archivo_predicciones)\n",
    "    print(f\"📊 Datos cargados: {len(df_predicciones):,} registros\")\n",
    "    print(f\"📋 Columnas disponibles: {list(df_predicciones.columns)}\")\n",
    "else:\n",
    "    print(\"⚠️ No se encontró archivo de predicciones. Buscando en variables del notebook...\")\n",

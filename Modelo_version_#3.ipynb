    "    \n",
    "    # Preparar datos satelitales para la fusión\n",
    "    # Crear una copia del DataFrame satelital con las columnas necesarias\n",
    "    df_sat_para_fusion = df_satelital_completo[['latitud', 'longitud', 'ndvi', 'pri']].copy()\n",
    "    \n",
    "    # Renombrar columnas para que coincidan con ERA5\n",
    "    df_sat_para_fusion = df_sat_para_fusion.rename(columns={\n",

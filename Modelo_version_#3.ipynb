    "bars = ax4.bar(categorias, [abs(v) for v in valores], color=colores, alpha=0.7)\n",
    "ax4.set_ylabel('Magnitud', fontweight='bold')\n",
    "ax4.set_title('Contexto de Emisiones/Absorción', fontweight='bold')\n",
    "ax4.grid(True, alpha=0.3)\n",

    "    else:\n",
    "        print(\"❌ Necesitamos generar las predicciones primero\")\n",
    "        df_predicciones = None\n",
    "\n",
    "if df_predicciones is not None:\n",
    "    # Identificar la columna NEE\n",
    "    columna_nee = None\n",
    "    for col in df_predicciones.columns:\n",

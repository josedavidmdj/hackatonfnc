    "# ========================================\n",
    "# VERIFICACIÓN DE MODELOS Y PREPARACIÓN DE DATOS\n",
    "# ========================================\n",
    "\n",
    "print(\"🔍 VERIFICANDO MODELOS DISPONIBLES Y DATOS\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "# Verificar que tenemos los modelos entrenados\n",
    "modelos_disponibles = []\n",
    "if 'modelo' in globals():\n",
    "    modelos_disponibles.append('modelo (principal)')\n",
    "if 'modelos' in globals():\n",
    "    modelos_disponibles.extend([f'modelos[{k}]' for k in modelos.keys()])\n",
    "if 'opt' in globals():\n",
    "    modelos_disponibles.append('opt (optimizado)')\n",
    "\n",
    "print(f\"✅ Modelos disponibles: {len(modelos_disponibles)}\")\n",
    "for i, mod in enumerate(modelos_disponibles, 1):\n",
    "    print(f\"   {i}. {mod}\")\n",
    "\n",
    "# Verificar datos integrados\n",
    "if 'df_completo' not in globals():\n",
    "    print(\"❌ df_completo no está disponible\")\n",
    "    raise ValueError(\"Necesitas ejecutar primero las celdas de integración de datos\")\n",
    "\n",
    "print(f\"\\n📊 BASE DE DATOS INTEGRADA:\")\n",
    "print(f\"   • Total registros: {len(df_completo):,}\")\n",
    "print(f\"   • Columnas: {len(df_completo.columns)}\")\n",
    "\n",
    "# Verificar qué registros tienen datos satelitales\n",
    "registros_con_satelital = df_completo['ndvi'].notna().sum()\n",
    "registros_sin_satelital = len(df_completo) - registros_con_satelital\n",
    "\n",
    "print(f\"   • Con datos satelitales: {registros_con_satelital:,}\")\n",
    "print(f\"   • Sin datos satelitales: {registros_sin_satelital:,}\")\n",
    "\n",
    "# Verificar las variables del modelo original\n",
    "if 'variables_del_modelo' in globals():\n",
    "    variables_modelo_orig = variables_del_modelo\n",
    "    print(f\"\\n🔧 VARIABLES DEL MODELO ORIGINAL:\")\n",
    "    print(f\"   • Variables: {variables_modelo_orig}\")\n",
    "else:\n",
    "    # Intentar reconstruir las variables del modelo basándose en lo que se usó antes\n",
    "    variables_posibles = ['TA_1_1_1', 'RH_1_1_1', 'VPD_PI', 'SW_IN_1_1_1', 'LW_IN', 'P', 'WS', 'ndvi', 'pri']\n",
    "    variables_modelo_orig = [var for var in variables_posibles if var in df_completo.columns]\n",
    "    print(f\"\\n🔧 VARIABLES RECONSTRUIDAS DEL MODELO:\")\n",
    "    print(f\"   • Variables estimadas: {variables_modelo_orig}\")\n",
    "\n",
    "# Verificar disponibilidad de las variables en los nuevos datos\n",
    "variables_disponibles_nuevos = []\n",
    "variables_faltantes = []\n",
    "\n",
    "for var in variables_modelo_orig:\n",
    "    if var in df_completo.columns:\n",
    "        valores_validos = df_completo[var].notna().sum()\n",
    "        variables_disponibles_nuevos.append(var)\n",
    "        print(f\"   ✅ {var}: {valores_validos:,} valores válidos\")\n",
    "    else:\n",
    "        variables_faltantes.append(var)\n",
    "        print(f\"   ❌ {var}: NO DISPONIBLE\")\n",
    "\n",
    "if variables_faltantes:\n",
    "    print(f\"\\n⚠️ VARIABLES FALTANTES: {variables_faltantes}\")\n",
    "    print(f\"   Usaremos solo las variables disponibles\")\n",
    "    variables_para_prediccion = variables_disponibles_nuevos\n",
    "else:\n",
    "    variables_para_prediccion = variables_modelo_orig\n",
    "\n",
    "print(f\"\\n🎯 VARIABLES PARA PREDICCIÓN:\")\n",
    "print(f\"   • Variables finales: {variables_para_prediccion}\")\n",
    "\n",
    "# Preparar subset de datos para predicción (solo registros con datos satelitales)\n",
    "df_para_prediccion = df_completo[df_completo['ndvi'].notna()].copy()\n",
    "\n",
    "print(f\"\\n📋 DATOS PREPARADOS PARA PREDICCIÓN:\")\n",
    "print(f\"   • Registros listos: {len(df_para_prediccion):,}\")\n",

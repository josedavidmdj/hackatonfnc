    "# Verificar qué archivos de predicciones tenemos\n",
    "import os\n",
    "archivos_disponibles = [f for f in os.listdir('.') if 'nee' in f.lower() and f.endswith('.csv')]\n",
    "print(f\"📂 Archivos NEE disponibles: {archivos_disponibles}\")\n",
    "\n",
    "# Cargar el archivo de predicciones correcto\n",
    "archivo_predicciones = None\n",

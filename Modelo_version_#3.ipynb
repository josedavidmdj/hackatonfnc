    "# ========================================\n",
    "# VISUALIZACIÓN DE PROMEDIOS TEMPORALES DEL NEE\n",
    "# ========================================\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "print(\"📊 GENERANDO VISUALIZACIONES...\")\n",
    "print(\"=\"*50)\n",
    "\n",
    "# Configurar estilo\n",
    "plt.style.use('seaborn-v0_8')\n",
    "sns.set_palette(\"husl\")\n",
    "\n",
    "# Crear figura con múltiples subplots\n",
    "fig, axes = plt.subplots(2, 2, figsize=(16, 12))\n",
    "fig.suptitle('🌱 ANÁLISIS TEMPORAL DEL NEE - CALDAS 2018', fontsize=16, fontweight='bold')\n",
    "\n",
    "# 1. PROMEDIO MENSUAL (Gráfico de línea)\n",
    "ax1 = axes[0, 0]\n",
    "meses_nombres_cortos = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun',\n",
    "                       'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic']\n",
    "\n",
    "promedios_mensuales = [resumen_mensual.loc[i, 'mean'] for i in range(1, 13)]\n",
    "std_mensuales = [resumen_mensual.loc[i, 'std'] for i in range(1, 13)]\n",
    "\n",
    "ax1.errorbar(range(1, 13), promedios_mensuales, yerr=std_mensuales, \n",
    "            marker='o', linewidth=2, markersize=8, capsize=5, capthick=2)\n",
    "ax1.set_xlabel('Mes', fontweight='bold')\n",
    "ax1.set_ylabel('NEE (µmol CO₂/m²/s)', fontweight='bold')\n",
    "ax1.set_title('Promedio Mensual del NEE', fontweight='bold')\n",
    "ax1.set_xticks(range(1, 13))\n",
    "ax1.set_xticklabels(meses_nombres_cortos, rotation=45)\n",
    "ax1.grid(True, alpha=0.3)\n",
    "ax1.axhline(y=0, color='red', linestyle='--', alpha=0.7, label='Balance neutro')\n",
    "ax1.legend()\n",
    "\n",
    "# Colorear según absorción/emisión\n",
    "for i, valor in enumerate(promedios_mensuales):\n",
    "    color = 'green' if valor < 0 else 'orange'\n",
    "    ax1.scatter(i+1, valor, s=100, c=color, alpha=0.7, zorder=5)\n",
    "\n",
    "# 2. DISTRIBUCIÓN MENSUAL (Box plot)\n",
    "ax2 = axes[0, 1]\n",
    "datos_por_mes = [df_predicciones[df_predicciones['mes'] == mes][columna_nee].values \n",
    "                for mes in range(1, 13)]\n",
    "\n",
    "box_plot = ax2.boxplot(datos_por_mes, labels=meses_nombres_cortos, patch_artist=True)\n",
    "ax2.set_xlabel('Mes', fontweight='bold')\n",
    "ax2.set_ylabel('NEE (µmol CO₂/m²/s)', fontweight='bold')\n",
    "ax2.set_title('Distribución Mensual del NEE', fontweight='bold')\n",
    "ax2.grid(True, alpha=0.3)\n",
    "ax2.tick_params(axis='x', rotation=45)\n",
    "\n",
    "# Colorear cajas según el promedio\n",
    "colores_cajas = ['lightgreen' if p < 0 else 'lightcoral' for p in promedios_mensuales]\n",
    "for patch, color in zip(box_plot['boxes'], colores_cajas):\n",
    "    patch.set_facecolor(color)\n",
    "    patch.set_alpha(0.7)\n",
    "\n",
    "# 3. BALANCE DE CARBONO MENSUAL\n",
    "ax3 = axes[1, 0]\n",
    "pct_absorcion_mensual = [balance_mensual.loc[i, 'pct_absorcion'] for i in range(1, 13)]\n",
    "pct_emision_mensual = [100 - pct for pct in pct_absorcion_mensual]\n",
    "\n",
    "x = range(1, 13)\n",
    "ax3.bar(x, pct_absorcion_mensual, label='Absorción CO₂', color='green', alpha=0.7)\n",
    "ax3.bar(x, pct_emision_mensual, bottom=pct_absorcion_mensual, \n",
    "        label='Emisión CO₂', color='orange', alpha=0.7)\n",
    "\n",
    "ax3.set_xlabel('Mes', fontweight='bold')\n",
    "ax3.set_ylabel('Porcentaje del tiempo (%)', fontweight='bold')\n",
    "ax3.set_title('Balance de Carbono Mensual', fontweight='bold')\n",
    "ax3.set_xticks(range(1, 13))\n",
    "ax3.set_xticklabels(meses_nombres_cortos, rotation=45)\n",
    "ax3.legend()\n",
    "ax3.grid(True, alpha=0.3)\n",
    "\n",
    "# 4. VARIABILIDAD MENSUAL\n",
    "ax4 = axes[1, 1]\n",
    "std_vals = [resumen_mensual.loc[i, 'std'] for i in range(1, 13)]\n",
    "bars = ax4.bar(range(1, 13), std_vals, color='skyblue', alpha=0.7, edgecolor='navy')\n",
    "\n",
    "ax4.set_xlabel('Mes', fontweight='bold')\n",
    "ax4.set_ylabel('Desviación Estándar', fontweight='bold')\n",
    "ax4.set_title('Variabilidad Mensual del NEE', fontweight='bold')\n",
    "ax4.set_xticks(range(1, 13))\n",
    "ax4.set_xticklabels(meses_nombres_cortos, rotation=45)\n",
    "ax4.grid(True, alpha=0.3)\n",
    "\n",
    "# Resaltar el mes más variable\n",
    "mes_mas_var_idx = std_vals.index(max(std_vals))\n",
    "bars[mes_mas_var_idx].set_color('red')\n",
    "bars[mes_mas_var_idx].set_alpha(0.8)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('nee_analisis_temporal_caldas_2018.png', dpi=300, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "# ========================================\n",
    "# GRÁFICO COMPLEMENTARIO: SERIE TEMPORAL DIARIA\n",
    "# ========================================\n",
    "\n",
    "print(\"\\n📈 GENERANDO SERIE TEMPORAL DIARIA...\")\n",
    "\n",
    "# Calcular promedio diario\n",
    "df_predicciones['fecha_solo'] = df_predicciones['fecha'].dt.date\n",
    "promedio_diario = df_predicciones.groupby('fecha_solo')[columna_nee].mean()\n",
    "\n",
    "fig, ax = plt.subplots(1, 1, figsize=(16, 6))\n",
    "\n",
    "# Gráfico de serie temporal\n",
    "ax.plot(promedio_diario.index, promedio_diario.values, linewidth=1, alpha=0.7, color='darkblue')\n",
    "\n",
    "# Línea de tendencia (media móvil de 30 días)\n",
    "media_movil = promedio_diario.rolling(window=30, center=True).mean()\n",
    "ax.plot(media_movil.index, media_movil.values, linewidth=3, color='red', \n",
    "        label='Media móvil (30 días)', alpha=0.8)\n",
    "\n",
    "ax.axhline(y=0, color='gray', linestyle='--', alpha=0.7, label='Balance neutro')\n",
    "ax.fill_between(promedio_diario.index, promedio_diario.values, 0, \n",
    "                where=(promedio_diario.values < 0), color='green', alpha=0.3, \n",
    "                label='Absorción neta')\n",
    "ax.fill_between(promedio_diario.index, promedio_diario.values, 0, \n",
    "                where=(promedio_diario.values >= 0), color='orange', alpha=0.3, \n",
    "                label='Emisión neta')\n",
    "\n",
    "ax.set_xlabel('Fecha', fontweight='bold')\n",
    "ax.set_ylabel('NEE Promedio Diario (µmol CO₂/m²/s)', fontweight='bold')\n",
    "ax.set_title('Serie Temporal del NEE - Caldas 2018', fontweight='bold', fontsize=14)\n",
    "ax.legend()\n",
    "ax.grid(True, alpha=0.3)\n",
    "\n",
    "# Formatear fechas en el eje x\n",
    "import matplotlib.dates as mdates\n",
    "ax.xaxis.set_major_formatter(mdates.DateFormatter('%b'))\n",
    "ax.xaxis.set_major_locator(mdates.MonthLocator())\n",
    "plt.xticks(rotation=45)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('nee_serie_temporal_diaria_caldas_2018.png', dpi=300, bbox_inches='tight')\n",

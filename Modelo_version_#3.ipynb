    "    if 'fecha' not in df_predicciones.columns:\n",
    "        for col in df_predicciones.columns:\n",
    "            if any(term in col.lower() for term in ['fecha', 'time', 'date', 'valid']):\n",
    "                df_predicciones['fecha'] = pd.to_datetime(df_predicciones[col])\n",
    "                print(f\"✅ Columna fecha: {col}\")\n",
    "                break\n",
    "    \n",
    "    # Crear columnas temporales\n",
    "    df_predicciones['año'] = df_predicciones['fecha'].dt.year\n",

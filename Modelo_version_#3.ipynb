    "# ========================================\n",
    "# DESCARGA DE DATOS REALES SENTINEL-2 (CORREGIDO)\n",
    "# ========================================\n",
    "\n",
    "print(\"🛰️ DESCARGANDO DATOS REALES DE SENTINEL-2\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "try:\n",
    "    import ee\n",
    "    import pandas as pd\n",
    "    from datetime import datetime\n",
    "    \n",
    "    # Usar el proyecto configurado\n",
    "    if 'PROJECT_ID' in locals():\n",
    "        ee.Initialize(project=PROJECT_ID)\n",
    "        print(f\"✅ Google Earth Engine inicializado con proyecto: {PROJECT_ID}\")\n",
    "    else:\n",
    "        ee.Initialize()\n",
    "        print(\"✅ Google Earth Engine inicializado\")\n",
    "    \n",
    "    # Las variables ya están definidas en el kernel global\n",
    "    # Solo verificar que existan y mostrar sus valores\n",
    "    print(f\"✅ Variables del proyecto confirmadas\")\n",
    "    \n",
    "    print(f\"📍 Ubicación: ({LATITUD}, {LONGITUD})\")\n",
    "    print(f\"📅 Período: {FECHA_INICIO} a {FECHA_FIN}\")\n",
    "    print(f\"🎯 Radio de búsqueda: {BUFFER_METROS} metros\")\n",
    "    \n",
    "    # Crear geometría del área de interés\n",
    "    punto_interes = ee.Geometry.Point([LONGITUD, LATITUD])\n",
    "    area_interes = punto_interes.buffer(BUFFER_METROS)\n",
    "    \n",
    "    # Configurar la búsqueda de imágenes Sentinel-2 con filtros realistas para datos reales\n",
    "    sentinel2_collection = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED') \\\n",
    "        .filterDate(FECHA_INICIO, FECHA_FIN) \\\n",
    "        .filterBounds(area_interes) \\\n",
    "        .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 25))  # Imágenes con < 25% nubes\n",
    "    \n",
    "    # VERIFICACIÓN CRÍTICA: Abortar si no hay imágenes reales disponibles\n",
    "    num_imagenes = sentinel2_collection.size().getInfo()\n",
    "    print(f\"🛰️ Imágenes Sentinel-2 encontradas: {num_imagenes}\")\n",
    "    \n",
    "    if num_imagenes == 0:\n",
    "        error_msg = \"❌ NO SE ENCONTRARON IMÁGENES SENTINEL-2 REALES para los parámetros especificados\"\n",
    "        print(error_msg)\n",
    "        print(f\"   📍 Coordenadas: ({LATITUD}, {LONGITUD})\")\n",
    "        print(f\"   📅 Período: {FECHA_INICIO} a {FECHA_FIN}\")\n",
    "        print(f\"   ☁️ Filtro de nubes: < 25%\")\n",
    "        print(\"🔧 Sugerencias:\")\n",
    "        print(\"   • Ampliar el rango de fechas\")\n",
    "        print(\"   • Aumentar el límite de nubes permitidas\")\n",
    "        print(\"   • Verificar las coordenadas\")\n",
    "        raise RuntimeError(\"ABORTANDO: No hay datos satelitales reales disponibles\")\n",
    "    \n",
    "    # Seleccionar la imagen con menos nubes (más limpia disponible)\n",
    "    imagen_seleccionada = sentinel2_collection \\\n",
    "        .sort('CLOUDY_PIXEL_PERCENTAGE') \\\n",
    "        .first()\n",
    "    \n",
    "    fecha_imagen = ee.Date(imagen_seleccionada.get('system:time_start')).format('YYYY-MM-dd').getInfo()\n",
    "    nubes_imagen = imagen_seleccionada.get('CLOUDY_PIXEL_PERCENTAGE').getInfo()\n",
    "    print(f\"✅ Imagen seleccionada: {fecha_imagen} (nubes: {nubes_imagen:.1f}%)\")\n",
    "    print(f\"📊 Esta es una imagen REAL de Sentinel-2, no simulada\")\n",
    "    \n",
    "    # Calcular índices NDVI y PRI para el área de interés\n",
    "    print(f\"\\n📊 CALCULANDO ÍNDICES ESPECTRALES:\")\n",
    "    \n",
    "    # Función para calcular NDVI y PRI\n",
    "    def calcular_indices(image):\n",
    "        # NDVI = (NIR - Red) / (NIR + Red)\n",
    "        ndvi = image.normalizedDifference(['B8', 'B4']).rename('NDVI')\n",
    "        \n",
    "        # PRI = (Green - Blue) / (Green + Blue)\n",
    "        pri = image.normalizedDifference(['B3', 'B2']).rename('PRI')\n",
    "        \n",
    "        return image.addBands([ndvi, pri])\n",
    "    \n",
    "    # Aplicar cálculo de índices\n",
    "    imagen_con_indices = calcular_indices(imagen_seleccionada)\n",
    "    \n",
    "    # Extraer valores promedio para el área de interés\n",
    "    valores_area = imagen_con_indices.select(['NDVI', 'PRI']).reduceRegion(\n",
    "        reducer=ee.Reducer.mean(),\n",
    "        geometry=area_interes,\n",
    "        scale=10,  # Resolución de 10m para Sentinel-2\n",
    "        maxPixels=1e9\n",
    "    ).getInfo()\n",
    "    \n",
    "    # Verificar que se obtuvieron valores válidos\n",
    "    if not valores_area or 'NDVI' not in valores_area or valores_area['NDVI'] is None:\n",
    "        raise RuntimeError(\"❌ No se pudieron extraer valores válidos del área de interés\")\n",
    "    \n",
    "    ndvi_valor = valores_area['NDVI']\n",
    "    pri_valor = valores_area['PRI']\n",
    "    \n",
    "    print(f\"   • NDVI promedio: {ndvi_valor:.4f}\")\n",
    "    print(f\"   • PRI promedio: {pri_valor:.4f}\")\n",
    "    \n",
    "    # Crear DataFrame con los datos satelitales REALES\n",
    "    df_satelital = pd.DataFrame({\n",
    "        'fecha': [fecha_imagen],\n",
    "        'ndvi': [ndvi_valor],\n",
    "        'pri': [pri_valor],\n",
    "        'nubes_porcentaje': [nubes_imagen],\n",
    "        'tipo_dato': ['REAL'],\n",
    "        'fuente': ['Sentinel-2 COPERNICUS/S2_SR_HARMONIZED'],\n",
    "        'coordenadas': [f\"({LATITUD}, {LONGITUD})\"],\n",
    "        'buffer_metros': [BUFFER_METROS]\n",
    "    })\n",
    "    \n",
    "    print(f\"\\n✅ DATOS SATELITALES REALES DESCARGADOS EXITOSAMENTE\")\n",
    "    print(f\"📋 DataFrame creado con {len(df_satelital)} registro real:\")\n",
    "    print(df_satelital)\n",
    "    \n",
    "    print(f\"\\n🔍 VERIFICACIÓN DE DATOS REALES:\")\n",
    "    print(f\"   • Fecha de imagen: {fecha_imagen}\")\n",
    "    print(f\"   • Coordenadas: ({LATITUD}, {LONGITUD})\")\n",
    "    print(f\"   • Calidad de imagen: {nubes_imagen:.1f}% nubes\")\n",
    "    print(f\"   • Resolución: 10m\")\n",
    "    print(f\"   • Fuente: Sentinel-2 (DATOS REALES)\")\n",
    "    print(f\"   • Estado: ✅ CONFIRMADO COMO DATOS REALES\")\n",
    "\n",
    "except Exception as e:\n",
    "    print(f\"❌ ERROR en descarga de datos satelitales: {e}\")\n",
    "    print(\"🛠️ Verifica:\")\n",

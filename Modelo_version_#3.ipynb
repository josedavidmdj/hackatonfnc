    "            variables_modelo = ['TA_1_1_1', 'RH_1_1_1', 'VPD_PI', 'SW_IN_1_1_1', 'LW_IN', 'P', 'WS', 'doy', 'hour', 'ndvi', 'pri']\n",
    "            X_para_prediccion = df_completo[variables_modelo].fillna(df_completo[variables_modelo].mean())\n",
    "            \n",
    "            # Aplicar scaler si está disponible\n",
    "            if 'scaler' in globals():\n",
    "                X_scaled = scaler.transform(X_para_prediccion)\n",
    "            else:\n",
    "                X_scaled = X_para_prediccion.values\n",
    "            \n",
    "            # Hacer predicciones\n",
    "            predicciones = modelo.predict(X_scaled)\n",
    "            \n",
    "            # Crear dataset con predicciones\n",
    "            df_predicciones = df_completo.copy()\n",
    "            df_predicciones['nee_predicted'] = predicciones\n",

    "# ========================================\n",
    "# INVESTIGACIÓN Y APLICACIÓN DEL MODELO CORRECTO\n",
    "# ========================================\n",
    "\n",
    "print(\"🔍 INVESTIGANDO MODELOS DISPONIBLES\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "# Investigar qué tipos de objetos tenemos\n",
    "print(\"📋 TIPOS DE MODELOS DISPONIBLES:\")\n",
    "\n",
    "if 'modelo' in globals():\n",
    "    print(f\"   • modelo: {type(modelo)} - {modelo}\")\n",
    "\n",
    "if 'modelos' in globals():\n",
    "    print(f\"   • modelos: {type(modelos)}\")\n",
    "    for k, v in modelos.items():\n",
    "        print(f\"     - {k}: {type(v)}\")\n",
    "\n",
    "if 'rf' in globals():\n",
    "    print(f\"   • rf: {type(rf)}\")\n",
    "\n",
    "if 'opt' in globals():\n",
    "    print(f\"   • opt: {type(opt)}\")\n",
    "    if hasattr(opt, 'best_estimator_'):\n",
    "        print(f\"     - best_estimator_: {type(opt.best_estimator_)}\")\n",
    "\n",
    "# Encontrar un modelo válido para predicción\n",
    "modelo_valido = None\n",
    "nombre_modelo_valido = None\n",
    "\n",
    "# Verificar modelo principal\n",
    "if 'modelo' in globals() and hasattr(modelo, 'predict'):\n",
    "    modelo_valido = modelo\n",
    "    nombre_modelo_valido = f\"modelo ({type(modelo).__name__})\"\n",
    "\n",
    "# Verificar modelos en diccionario\n",
    "elif 'modelos' in globals():\n",
    "    for nombre, mod in modelos.items():\n",
    "        if hasattr(mod, 'predict'):\n",
    "            modelo_valido = mod\n",
    "            nombre_modelo_valido = f\"modelos[{nombre}] ({type(mod).__name__})\"\n",
    "            break\n",
    "\n",
    "# Verificar rf\n",
    "elif 'rf' in globals() and hasattr(rf, 'predict'):\n",
    "    modelo_valido = rf\n",
    "    nombre_modelo_valido = f\"rf ({type(rf).__name__})\"\n",
    "\n",
    "# Verificar optimizado\n",
    "elif 'opt' in globals() and hasattr(opt, 'best_estimator_'):\n",
    "    modelo_valido = opt.best_estimator_\n",
    "    nombre_modelo_valido = f\"opt.best_estimator_ ({type(opt.best_estimator_).__name__})\"\n",
    "\n",
    "print(f\"\\n🎯 MODELO SELECCIONADO:\")\n",
    "if modelo_valido:\n",
    "    print(f\"   ✅ {nombre_modelo_valido}\")\n",
    "    \n",
    "    # Aplicar el modelo válido\n",
    "    print(f\"\\n📊 APLICANDO MODELO SELECCIONADO...\")\n",
    "    \n",
    "    # Preparar datos\n",
    "    df_prediccion = df_completo[df_completo['NDVI'].notna()].copy()\n",
    "    caracteristicas = ['TA_1_1_1', 'RH_1_1_1', 'VPD_PI', 'SW_IN_1_1_1', 'LW_IN', 'WS', 'NDVI', 'PRI', 'doy', 'hour']\n",
    "    \n",
    "    print(f\"   • Registros: {len(df_prediccion):,}\")\n",
    "    print(f\"   • Características: {len(caracteristicas)}\")\n",
    "    \n",
    "    # Tomar una muestra para prueba primero\n",
    "    muestra_size = min(5000, len(df_prediccion))\n",
    "    df_muestra = df_prediccion.sample(n=muestra_size, random_state=42)\n",
    "    X_muestra = df_muestra[caracteristicas]\n",
    "    \n",
    "    print(f\"\\n🧪 PRUEBA CON MUESTRA DE {muestra_size:,} REGISTROS...\")\n",
    "    \n",
    "    try:\n",
    "        # Determinar si necesita escalado\n",
    "        tipo_modelo = type(modelo_valido).__name__\n",
    "        if tipo_modelo in ['RandomForestRegressor', 'GradientBoostingRegressor']:\n",
    "            print(f\"   🌲 {tipo_modelo} - Sin escalado\")\n",
    "            X_muestra_proc = X_muestra\n",
    "        else:\n",
    "            print(f\"   🔄 {tipo_modelo} - Con escalado\")\n",
    "            X_muestra_proc = scaler.transform(X_muestra)\n",
    "        \n",
    "        # Predicción de prueba\n",
    "        pred_muestra = modelo_valido.predict(X_muestra_proc)\n",
    "        print(f\"   ✅ Prueba exitosa\")\n",
    "        print(f\"   📊 Muestra predicciones: {pred_muestra.mean():.4f} ± {pred_muestra.std():.4f}\")\n",
    "        \n",
    "        # Procesar dataset completo en lotes\n",
    "        print(f\"\\n🚀 PROCESANDO DATASET COMPLETO...\")\n",
    "        X_completo = df_prediccion[caracteristicas]\n",
    "        \n",
    "        tamaño_lote = 25000  # Lotes más pequeños\n",
    "        predicciones_totales = []\n",
    "        \n",
    "        num_lotes = (len(X_completo) + tamaño_lote - 1) // tamaño_lote\n",
    "        print(f\"   • Procesando en {num_lotes} lotes de {tamaño_lote:,}\")\n",
    "        \n",
    "        for i in range(num_lotes):\n",
    "            inicio = i * tamaño_lote\n",
    "            fin = min((i + 1) * tamaño_lote, len(X_completo))\n",
    "            \n",
    "            print(f\"     Lote {i+1}/{num_lotes}: {inicio:,}-{fin:,}\")\n",
    "            \n",
    "            X_lote = X_completo.iloc[inicio:fin]\n",
    "            \n",
    "            # Aplicar escalado si es necesario\n",
    "            if tipo_modelo in ['RandomForestRegressor', 'GradientBoostingRegressor']:\n",
    "                X_lote_proc = X_lote\n",
    "            else:\n",
    "                X_lote_proc = scaler.transform(X_lote)\n",
    "            \n",
    "            pred_lote = modelo_valido.predict(X_lote_proc)\n",
    "            predicciones_totales.extend(pred_lote)\n",
    "        \n",
    "        # Convertir a numpy array\n",
    "        predicciones_nee = np.array(predicciones_totales)\n",
    "        \n",
    "        # Añadir al DataFrame\n",
    "        df_prediccion['NEE_predicho'] = predicciones_nee\n",
    "        \n",
    "        print(f\"\\n✅ PREDICCIONES COMPLETADAS\")\n",
    "        print(f\"   • Total: {len(predicciones_nee):,}\")\n",
    "        print(f\"   • Modelo: {tipo_modelo}\")\n",
    "        \n",
    "        print(f\"\\n📊 ESTADÍSTICAS FINALES:\")\n",
    "        print(f\"   • NEE promedio: {predicciones_nee.mean():.4f}\")\n",
    "        print(f\"   • NEE mín/máx: {predicciones_nee.min():.4f} / {predicciones_nee.max():.4f}\")\n",
    "        print(f\"   • Desviación std: {predicciones_nee.std():.4f}\")\n",
    "        \n",
    "        # Análisis por ubicación\n",
    "        resumen_ubicaciones = df_prediccion.groupby(['latitude', 'longitude']).agg({\n",
    "            'NEE_predicho': ['mean', 'std', 'count'],\n",
    "            'NDVI': 'mean',\n",
    "            'PRI': 'mean'\n",
    "        }).round(4)\n",
    "        \n",
    "        print(f\"\\n🗺️ RESUMEN ESPACIAL:\")\n",
    "        print(f\"   • Ubicaciones: {len(resumen_ubicaciones)}\")\n",
    "        \n",
    "        # Guardar resultados\n",
    "        archivo_resultado = f'predicciones_nee_{tipo_modelo.lower()}_final.csv'\n",
    "        df_prediccion[['valid_time', 'latitude', 'longitude', 'NDVI', 'PRI', 'NEE_predicho']].to_csv(archivo_resultado, index=False)\n",
    "        \n",
    "        print(f\"\\n💾 ARCHIVO GUARDADO: {archivo_resultado}\")\n",
    "        print(f\"   • Registros: {len(df_prediccion):,}\")\n",
    "        \n",
    "        print(f\"\\n🎉 APLICACIÓN DEL MODELO COMPLETADA EXITOSAMENTE\")\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f\"❌ Error en aplicación: {e}\")\n",
    "        import traceback\n",
    "        traceback.print_exc()\n",
    "\n",
    "else:\n",
    "    print(f\"   ❌ No se encontró un modelo válido\")\n",
    "    print(f\"   🔧 Verifica que los modelos estén entrenados correctamente\")"
   ]

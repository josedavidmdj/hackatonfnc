    "# ========================================\n",
    "# DIAGNÓSTICO DE DISPONIBILIDAD DE DATOS SENTINEL-2\n",
    "# ========================================\n",
    "\n",
    "print(\"🔍 DIAGNÓSTICO DE DATOS SENTINEL-2\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "# Verificar que GEE esté inicializado\n",
    "try:\n",
    "    import ee\n",
    "    \n",
    "    # Usar el proyecto configurado\n",
    "    if 'PROJECT_ID' in locals():\n",
    "        ee.Initialize(project=PROJECT_ID)\n",
    "        print(f\"✅ Google Earth Engine inicializado con proyecto: {PROJECT_ID}\")\n",
    "    else:\n",
    "        ee.Initialize()\n",
    "        print(\"✅ Google Earth Engine inicializado\")\n",
    "    \n",
    "    # Usar las coordenadas y fechas de las variables existentes\n",
    "    print(f\"\\n📍 PARÁMETROS DE BÚSQUEDA:\")\n",
    "    print(f\"   • Latitud: {LATITUD}\")\n",
    "    print(f\"   • Longitud: {LONGITUD}\")\n",
    "    print(f\"   • Fecha inicio: {FECHA_INICIO}\")\n",
    "    print(f\"   • Fecha fin: {FECHA_FIN}\")\n",
    "    print(f\"   • Buffer: {BUFFER_METROS} metros\")\n",
    "    \n",
    "    # Crear punto y área de interés\n",
    "    punto_interes = ee.Geometry.Point([LONGITUD, LATITUD])\n",
    "    area_interes = punto_interes.buffer(BUFFER_METROS)\n",
    "    \n",
    "    print(f\"\\n🛰️ BÚSQUEDA DE IMÁGENES SENTINEL-2:\")\n",
    "    \n",
    "    # Búsqueda básica sin filtros estrictos\n",
    "    sentinel2_basico = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED') \\\n",
    "        .filterDate(FECHA_INICIO, FECHA_FIN) \\\n",
    "        .filterBounds(area_interes)\n",
    "    \n",
    "    num_imagenes_basico = sentinel2_basico.size().getInfo()\n",
    "    print(f\"   • Imágenes sin filtro de nubes: {num_imagenes_basico}\")\n",
    "    \n",
    "    if num_imagenes_basico > 0:\n",
    "        # Búsqueda con diferentes filtros de nubes\n",
    "        for cloud_limit in [50, 30, 20, 10]:\n",
